---
// Preview switcher, shown only with ?demo in the URL. Not part of the design.
import { iff } from '../lib/ssr';
const viewers: [string, string, string][] = [['out', 'Deconectat', 'demoOut'], ['nonsub', 'Neabonat', 'demoNonsub'], ['sub', 'Abonat', 'demoSub']];
const streams: [string, string, string][] = [['live', 'Live', 'demoLive'], ['upcoming', 'Începe curând', 'demoUpcoming']];
---
<details class="demo" open {...iff('demo')}>
  <summary>Demo · stări</summary>
  <div class="demo-body">
    <div class="demo-row" role="group" aria-label="Vizitator">
      <span>Vizitator</span>
      {viewers.map(([id, label, key]) => <button type="button" data-action="setViewer" data-arg={id} data-attr={`aria-pressed:${key}`} aria-pressed="false">{label}</button>)}
    </div>
    <div class="demo-row" role="group" aria-label="Stream">
      <span>Stream</span>
      {streams.map(([id, label, key]) => <button type="button" data-action="setStream" data-arg={id} data-attr={`aria-pressed:${key}`} aria-pressed="false">{label}</button>)}
    </div>
    <div class="demo-row">
      <span>Ninsoare</span>
      <button type="button" data-action="toggleSnow" data-attr="aria-pressed:demoSnow" data-text="demoSnowLabel" aria-pressed="true">Pornită</button>
    </div>
  </div>
</details>
