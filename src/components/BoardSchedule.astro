---
// 07 Clasament (the Christmas programme was removed on the owner's request).
import SectionHead from './SectionHead.astro';
import { v, iff } from '../lib/ssr';
import { views } from '../lib/views';
---
<section style="position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: clamp(56px, 8cqi, 112px) clamp(20px, 4cqi, 40px); display: flex; flex-wrap: wrap; gap: 48px 64px">
  <div id="board" style="flex: 1 1 440px; min-width: 0">
    <SectionHead compact tag="07" bignum="07" title="Clasament" />
    <div role="tablist" aria-label="Tip clasament" data-region="boardTabs" style="display: flex; flex-wrap: wrap; gap: 0 24px; border-bottom: 1px solid #1A2230" set:html={views.boardTabs(v)} />
    <div id="panel-board" role="tabpanel" aria-labelledby={v.boardLabelledBy} data-attr="aria-labelledby:boardLabelledBy">
      <ol data-region="board" style="list-style: none; margin: 0; padding: 0" set:html={views.board(v)} />
    </div>
    <div style="margin-top: 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; font-size: 14px; color: #AEB8C7">
      <p style="margin: 0; flex: 1 1 260px" data-text="privacyText">{v.privacyText}</p>
      <button type="button" class="btn-ghost" data-action="togglePublic" aria-pressed={v.privacyPressed} data-attr="aria-pressed:privacyPressed" {...iff('isIn')} style="min-height: 44px; padding: 0 14px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em" data-text="privacyBtn">{v.privacyBtn}</button>
    </div>
  </div>
</section>
