---
// Partenerii ICEMARATON: one calm logo wall right under the hero. Every slot is shown,
// the empty ones too (owner, 23 Nov: sponsors and viewers should see every place there is).
// The main partner leads; its offer and code sit under the timer (Hero.astro, #oferta).
// Logos are placeholders until the sponsors send files (src/data/site.ts).
import { site } from '../data/site';
import { demoSponsors } from '../data/demoSponsors';
import PartnerWall from './PartnerWall.astro';
---
<section id="parteneri" aria-labelledby="h-parteneri" class="pwall">
  <div class="wrap">
    <div class="pw-head">
      <h2 id="h-parteneri" class="pw-title">Partenerii ICEMARATON</h2>
      <p class="pw-side">Ei fac posibile premiile, roata și orele în plus.</p>
    </div>

    <div data-demo="pw-demo"><PartnerWall partners={site.partners} supporters={site.supporters} /></div>
    <template id="pw-demo"><PartnerWall partners={demoSponsors.partners} supporters={demoSponsors.supporters} demo /></template>
    <p class="pw-join">Vrei să fii aici? <a href="/sponsori/">Vezi pachetele pentru parteneri →</a></p>
  </div>
</section>
