---
// 01 Partenerii subathonului (right after the timer, owner's request). Logos are placeholders until sponsors send files.
import SectionHead from './SectionHead.astro';
import { v } from '../lib/ssr';
import { partners, supporters } from '../data/content';
import { site } from '../data/site';
const cond = "'Barlow Condensed', sans-serif";
const h3 = `font-family: ${cond}; font-weight: 800; font-size: 20px; letter-spacing: 0.12em; text-transform: uppercase; color: #AEB8C7`;
const corners = ['c-tl', 'c-tr', 'c-bl', 'c-br'];
---
<section id="parteneri" aria-labelledby="h-parteneri" style="position: relative; z-index: 1; max-width: 1280px; margin: clamp(40px, 5cqi, 72px) auto 0; padding: 0 clamp(20px, 4cqi, 40px) clamp(56px, 8cqi, 112px)">
  <SectionHead tag="01" bignum="01" title="Partenerii subathonului" id="h-parteneri">
    <p style="margin: 0; max-width: 420px; font-size: 17px; color: #AEB8C7">Ei fac posibile premiile, roata și orele în plus. Treceți pe la ei.</p>
  </SectionHead>

  <!-- Main partner -->
  <div style="position: relative; margin-top: 32px; background: #0B1018; border: 1px solid #1C2230; display: flex; flex-wrap: wrap; align-items: stretch">
    {corners.map((c) => <span aria-hidden="true" class={`corner ${c}`}></span>)}
    <div style="flex: 1 1 340px; min-width: 0; min-height: 220px; display: grid; place-items: center; padding: clamp(24px, 4cqi, 48px); background: radial-gradient(ellipse at 50% 50%, rgba(63,208,255,0.10), rgba(63,208,255,0) 70%); border-right: 1px solid #1C2230">
      <span style="display: flex; flex-direction: column; align-items: center; gap: 10px"><span style="font-family: Barlow, sans-serif; font-weight: 700; font-size: clamp(40px, 5cqi, 64px); letter-spacing: 0.06em; color: #FFFFFF">{site.sponsor.logoText}</span><span style="font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: #7D8899">Aici vine logo-ul oficial</span></span>
    </div>
    <div style="flex: 1.4 1 420px; min-width: 0; padding: clamp(24px, 4cqi, 48px); display: flex; flex-direction: column; justify-content: center">
      <span style={`align-self: flex-start; padding: 2px 10px; transform: skewX(-12deg); background: var(--ice); color: #04101A; font-family: ${cond}; font-size: 14px; font-weight: 800; letter-spacing: 0.08em`}>PARTENER PRINCIPAL</span>
      <h3 style={`margin: 16px 0 0; font-family: ${cond}; font-weight: 900; font-style: italic; font-size: clamp(34px, 4cqi, 52px); line-height: 0.95; text-transform: uppercase`}>{site.sponsor.name}</h3>
      <p style="margin: 12px 0 0; max-width: 520px; font-size: 17px; color: #AEB8C7">{site.sponsor.pitch}</p>
      <div style="margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px">
        <button type="button" data-action="copyCode" data-track={`${site.sponsor.name}|code_copy`} aria-label="Copiază codul de reducere" style="min-height: 52px; display: inline-flex; align-items: center; gap: 14px; padding: 0 16px; background: transparent; border: 2px dashed var(--ice); color: #F2F5FA">
          <span style="font-size: 13px; color: #8C97A8">Cod</span>
          <span style={`font-family: ${cond}; font-weight: 900; font-style: italic; font-size: 24px; letter-spacing: 0.04em`}>{site.sponsor.code}</span>
          <span data-text="codeLabel" style={`font-family: ${cond}; font-weight: 800; font-size: 15px; text-transform: uppercase; color: var(--ice)`}>{v.codeLabel}</span>
        </button>
        <span class="sr-only" role="status" data-text="codeStatus"></span>
        <a class="btn-primary" href={site.sponsor.offerUrl} data-track={`${site.sponsor.name}|click`} style={`min-height: 52px; display: inline-flex; align-items: center; padding: 0 24px; font-family: ${cond}; font-weight: 800; font-size: 20px; text-transform: uppercase; text-decoration: none`}>Vezi oferta →</a>
      </div>
    </div>
  </div>

  <!-- Partners -->
  <h3 style={`margin: 48px 0 0; ${h3}`}>Parteneri</h3>
  <div style="margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px">
    {partners.map((pt) => (
      <a class="ptile" href={pt.href} data-track={`${pt.name}|click`} style="display: flex; flex-direction: column; gap: 14px; padding: 20px; background: #0B1018; border: 1px solid #1C2230; text-decoration: none; color: #F2F5FA">
        <span class="logo-slot" style="width: 100%; height: 96px; font-size: 12px">Logo</span>
        <span style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px">
          <span style="font-weight: 700; font-size: 17px">{pt.name}</span>
          <span style={`font-family: ${cond}; font-weight: 700; font-size: 14px; letter-spacing: 0.06em; text-transform: uppercase; color: #8C97A8`}>{pt.role}</span>
        </span>
      </a>
    ))}
  </div>

  <!-- Supporters -->
  <h3 style={`margin: 40px 0 0; ${h3}`}>Susținători</h3>
  <div style="margin-top: 14px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 150px), 1fr)); gap: 10px">
    {supporters.map((su) => (
      <a class="ptile logo-slot" href={su.href} style="height: 72px; font-size: 11px; text-decoration: none; border-style: solid; border-color: #1C2230; background: #090C11">{su.label}</a>
    ))}
  </div>
  <p style="margin: 28px 0 0; font-size: 15px; color: #8C97A8">Vrei să fii partener la subathon? <a href={`mailto:${site.contactEmail}`} style="font-weight: 600">Scrie-ne la {site.contactEmail}</a></p>
</section>
