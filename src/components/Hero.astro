---
// Hero (#timer): the marathon and its main partner, nothing else. The title with
// «Prezentat de» under it; Iceman reacting in a bubble (left); the line, the timer
// card (Acum pe stream, the clock, Strâns · Următorul milestone) with the main
// partner's offer attached under it, and the buttons (right). Rates and the
// calculator live in AddTime.astro, all partners in Partners.astro.
import { getImage } from 'astro:assets';
import logo from '../../assets/logo-mascot.webp';
import { v, iff } from '../lib/ssr';
import { views } from '../lib/views';
import { site } from '../data/site';
import { demoSponsors } from '../data/demoSponsors';
import PartnerRow from './PartnerRow.astro';

const cond = "'Barlow Condensed', sans-serif";
// The mascot is the largest thing on a phone's first screen (its main paint), so it gets
// AVIF at a lower quality setting (half the bytes of WebP, same look up close) with WebP
// for older browsers. getImage, not <Picture>, because the two formats need different qualities.
const mascotWidths = [300, 420, 520, 600, 700, 780, 1040, 1200];
const mascotSizes = '(min-width: 3400px) 1040px, (min-width: 2400px) 694px, (max-width: 760px) 74vw, 520px';
const mascotAvif = await getImage({ src: logo, format: 'avif', quality: 48, widths: mascotWidths, sizes: mascotSizes });
const mascotWebp = await getImage({ src: logo, format: 'webp', quality: 72, widths: mascotWidths, sizes: mascotSizes });
const units = [['dd', 'ZILE'], ['hh', 'ORE'], ['mm', 'MINUTE'], ['ss', 'SECUNDE']] as const;
// No dead «Donează» links: the donate buttons appear once site.links.donate is set (V2).
const hasDonate = !!site.links.donate && site.links.donate !== '#';
const hasOffer = !!site.sponsor.offerUrl && site.sponsor.offerUrl !== '#';
const FLAKE = 'M12 2v20M3.3 7l17.4 10M3.3 17l17.4-10M9 4l3 2 3-2M9 20l3-2 3 2';
---
<section id="timer" aria-label="ICEMARATON: timp rămas" class="hero">
  <div class="wrap">
    <p class="hero-eyebrow">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3FD0FF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={FLAKE}></path></svg>
      Stream maraton 2026–2027
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3FD0FF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={FLAKE}></path></svg>
    </p>
    <h1><span class="ice-text">ICE</span><span style="color: var(--ice)">MARATON</span></h1>
    <!-- The sponsors, right under the name: the main partner first, then the partners
         (demo mode swaps in the invented partners from src/data/demoSponsors.ts). -->
    <div class="sponsor-line">
      <a id="prezentat" class="title-sponsor" href={hasOffer ? site.sponsor.offerUrl : '#oferta'} data-track={hasOffer ? `${site.sponsor.name}|click` : undefined}>
        <span class="ts-l">Prezentat de</span>
        {site.sponsor.logo
          ? <img class="ts-logo" src={site.sponsor.logo} alt={site.sponsor.name} />
          : <span class="ts-name" data-sponsor="logo">{site.sponsor.logoText}</span>}
      </a>
      <div data-demo="tp-demo"><PartnerRow partners={site.partners} /></div>
    </div>
    <template id="tp-demo"><PartnerRow partners={demoSponsors.partners} /></template>

    <div class="stage">
      <!-- Middle: Iceman reacts -->
      <div class="st-mascot">
        <picture>
          <source type="image/avif" srcset={mascotAvif.srcSet.attribute} sizes={mascotSizes} />
          <img class="mascot fx-hop" data-toggle="fxA:fxA;fxB:fxB" src={mascotWebp.src} srcset={mascotWebp.srcSet.attribute} sizes={mascotSizes} width={mascotWebp.attributes.width} height={mascotWebp.attributes.height} alt="Icemanlucky" loading="eager" decoding="async" fetchpriority="high" />
        </picture>
        <!-- Iceman's callout: who gave what (+time), his line typed in, the queue behind it.
             Hover or focus holds it; «încă N ›» skips to the next one. -->
        <div class="bubble fx-bub" {...iff('bubbleOn')} data-toggle="fxA:fxA;fxB:fxB" data-style="--acc:bubbleAccent" style={`--acc: ${v.bubbleAccent}`}>
          <span class="bub-corner" aria-hidden="true"></span>
          <p class="bub-head" aria-hidden="true"><span class="bub-user" data-text="bubbleUser">{v.bubbleUser}</span><strong class="bub-time" data-text="bubbleTime">{v.bubbleTime}</strong></p>
          <p class="bub-what" aria-hidden="true" data-text="bubbleWhat">{v.bubbleWhat}</p>
          <p class="bub-line" aria-hidden="true"><span class="bub-ghost">{v.bubbleText}</span><span class="bub-typed">{v.bubbleText}</span></p>
          <p class="sr-only" role="status" data-text="bubbleSay">{v.bubbleSay}</p>
          <button type="button" class="bub-next" data-action="bubbleNext" {...iff('bubbleQueueOn')} aria-label={v.bubbleNextLabel} data-attr="aria-label:bubbleNextLabel">
            <span class="bub-bar" aria-hidden="true"><i></i></span><span data-text="bubbleQueueText">{v.bubbleQueueText}</span><span aria-hidden="true">›</span>
          </button>
          <span class="bubble-tail" aria-hidden="true"></span>
        </div>
        <div class="chip-ev" {...iff('chipOn')} aria-hidden="true">
          <span class="blink" style="flex: none; width: 7px; height: 7px; background: #D5162B"></span>
          <strong data-text="chipTime" style={`flex: none; font-family: ${cond}; font-weight: 800; font-size: 17px; color: var(--ice)`}>{v.chipTime}</strong>
          <span style="flex: 1 1 auto; min-width: 0; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis"><strong data-text="chipUser">{v.chipUser}</strong> <span data-text="chipWhat" style="color: #AEB8C7">{v.chipWhat}</span></span>
        </div>
      </div>

      <!-- The line -->
      <div class="st-line">
        <div class="display">
          <span class="rule" aria-hidden="true" style="background: linear-gradient(90deg, rgba(63,208,255,0), #3FD0FF)"></span>
          <p>Voi decideți <span class="br"></span><span class="ice-text">cât durează.</span></p>
          <span class="rule" aria-hidden="true" style="background: linear-gradient(90deg, #3FD0FF, rgba(63,208,255,0))"></span>
        </div>
        <p class="sub-line"><span class="sl-long">Fiecare sub și fiecare donație adaugă timp pe cronometru</span><span class="sl-short">Fiecare sub și donație adaugă timp</span></p>
      </div>

      <!-- The timer card -->
      <div class="st-timer">
        <div class="timer-card">
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
            <span data-text="timerLabel" style={`font-family: ${cond}; font-weight: 800; font-style: italic; font-size: 18px; letter-spacing: 0.1em; text-transform: uppercase; color: #AEB8C7`}>{v.timerLabel}</span>
            <span data-text="statusText" data-style="background:liveBg" style={`padding: 3px 12px; transform: skewX(-12deg); background: ${v.liveBg}; color: #FFFFFF; font-family: ${cond}; font-weight: 800`}>{v.statusText}</span>
          </div>
          <p {...iff('hasNow')} style="margin: 8px 0 0; font-size: 15px; color: #C9D2DF; overflow-wrap: anywhere"><strong data-text="nowLabel" style={`font-family: ${cond}; letter-spacing: 0.1em; color: var(--ice); margin-right: 8px; text-transform: uppercase`}>{v.nowLabel}</strong><span data-text="nowText">{v.nowText}</span></p>
          <div class="units">
            <span class="pop-tag fx-pop" aria-hidden="true" data-toggle="fxA:fxA;fxB:fxB" data-text="popText">{v.popText}</span>
            {units.map(([key, label], i) => (
              <div>
                <div class="unit-box fx-glow" data-toggle="fxA:fxA;fxB:fxB"><span class="unit-num" data-text={key}>{v[key]}</span><span aria-hidden="true" class="glint" style={`animation-delay: ${i * 0.25}s`}></span></div>
                <div class="unit-label">{label}</div>
              </div>
            ))}
          </div>
          <p {...iff('isEnded')} data-text="endedText" style="margin: 14px 0 0; padding: 10px 12px; border-left: 3px solid var(--ice); background: rgba(63, 208, 255, 0.06); font-size: 15px; font-weight: 600; color: #F2F5FA">{v.endedText}</p>
          <div class="score">
            <div><p class="lbl">Strâns până acum</p><p class="val" data-text="raisedText">{v.raisedText}</p></div>
            <div><p class="lbl">Următorul milestone</p><p class="val" data-text="nextGoalText" style="color: var(--ice)">{v.nextGoalText}</p></div>
          </div>
          <div class="bar" style="margin-top: 16px" role="img" aria-label={`Spre următorul milestone: ${v.progressLabel}`} data-attr="aria-label:progressAria"><span data-style="width:progressPct" style={`width: ${v.progressPct}`}></span></div>
          <p {...iff('isFrozen')} style="margin: 12px 0 0; font-size: 14px; color: #C9D2DF"><strong style={`font-family: ${cond}; font-weight: 800; font-style: italic; color: var(--ice); letter-spacing: 0.04em`}>ÎNGHEȚAT</strong> <span data-text="frozenText">{v.frozenText}</span></p>
          <p {...iff('hasDouble')} style="margin: 12px 0 0; font-size: 14px; color: #C9D2DF"><strong style={`font-family: ${cond}; font-weight: 800; font-style: italic; color: #FFFFFF; letter-spacing: 0.04em`}>ORA DUBLĂ</strong> <span data-text="doubleText">{v.doubleText}</span></p>
        </div>
        <!-- The main partner's offer, attached to the timer card: code to copy and the link. -->
        <div id="oferta" class="sponsor-bar">
          <p class="sb-t">Oferta <span data-sponsor="name">{site.sponsor.name}</span> pentru comunitate</p>
          <div class="sb-actions">
            <button type="button" class="sb-code" data-action="copyCode" data-track={`${site.sponsor.name}|code_copy`}>
              <span class="sb-code-l">Cod de reducere</span>
              <span class="sb-code-v" data-sponsor="code">{site.sponsor.code}</span>
              <span class="sb-copy" data-text="codeLabel">{v.codeLabel}</span>
            </button>
            <span class="sr-only" role="status" data-text="codeStatus"></span>
            {hasOffer && <a class="btn-primary sb-offer" href={site.sponsor.offerUrl} data-track={`${site.sponsor.name}|click`}>Vezi oferta →</a>}
          </div>
        </div>
      </div>

      <div class="st-cta">
        <div class="cta-row">
          <a class="btn-primary" href={site.links.twitch} style={`font-family: ${cond}; font-weight: 900; font-style: italic`}>Urmărește live</a>
          {hasDonate && <a class="btn-ghost cta-donate" href={site.links.donate} style={`font-family: ${cond}; font-weight: 800`}>Donează</a>}
          <a class="btn-ghost" href={site.links.subscribe} style={`font-family: ${cond}; font-weight: 800`}>Dă un sub</a>
        </div>
      </div>

      <!-- What this viewer can do now: full width under both columns (only while live) -->
      <nav class="st-next next-row" aria-labelledby="nr-title" {...iff('nextOn')}>
        <p class="nr-t" id="nr-title">Ce poți face acum</p>
        <div class="nr-tiles" data-region="nextRow" set:html={views.nextRow(v)} />
      </nav>
    </div>
  </div>
</section>
