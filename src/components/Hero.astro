---
// Hero (#timer): a live stage. Desktop: «INTRĂ ACUM» (left) · Iceman reacting in
// a bubble (middle) · «Cât adaugi tu?» (right); then the line, the timer card
// (Acum pe stream, the jumping clock, Strâns · Prezentat de · Următorul
// milestone, the rate chips) and the two buttons. Phone: the bubble sits on the
// illustration with one «intră acum» strip, the calculator goes under the timer.
import { Image } from 'astro:assets';
import logo from '../../assets/logo-mascot.webp';
import { v, iff } from '../lib/ssr';
import { views } from '../lib/views';
import { site } from '../data/site';
import { rateChips } from '../data/content';

const cond = "'Barlow Condensed', sans-serif";
const units = [['dd', 'ZILE'], ['hh', 'ORE'], ['mm', 'MINUTE'], ['ss', 'SECUNDE']] as const;
const FLAKE = 'M12 2v20M3.3 7l17.4 10M3.3 17l17.4-10M9 4l3 2 3-2M9 20l3-2 3 2';
---
<section id="timer" aria-label="ICEMARATON: timp rămas" class="hero">
  <div class="wrap">
    <p class="hero-eyebrow">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3FD0FF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={FLAKE}></path></svg>
      Stream maraton 2026–2027
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3FD0FF" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={FLAKE}></path></svg>
    </p>
    <h1><span class="ice-text">ICE</span><span style="color: var(--ice)">MARATON</span></h1>

    <div class="stage">
      <!-- Left: the newest events -->
      <div class="st-ev">
        <p class="ev-head"><span class="blink" style="width: 8px; height: 8px; background: #D5162B"></span>INTRĂ ACUM</p>
        <div data-region="heroRecent" aria-live="polite" set:html={views.heroRecent(v)} />
      </div>

      <!-- Middle: Iceman reacts -->
      <div class="st-mascot">
        <Image class="mascot fx-hop" data-toggle="fxA:fxA;fxB:fxB" src={logo} alt="Icemanlucky" widths={[300, 420, 520, 780, 1040]} sizes="(max-width: 760px) 74vw, 520px" quality={72} loading="eager" fetchpriority="high" />
        <div class="bubble fx-bub" role="status" {...iff('bubbleOn')} data-toggle="fxA:fxA;fxB:fxB">
          <span class="bubble-who" data-text="bubbleWho">{v.bubbleWho}</span><span data-text="bubbleText">{v.bubbleText}</span>
          <span class="bubble-tail" aria-hidden="true"></span>
        </div>
        <div class="chip-ev" {...iff('chipOn')} aria-hidden="true">
          <span class="blink" style="flex: none; width: 7px; height: 7px; background: #D5162B"></span>
          <strong data-text="chipTime" style={`flex: none; font-family: ${cond}; font-weight: 800; font-size: 17px; color: var(--ice)`}>{v.chipTime}</strong>
          <span style="flex: 1 1 auto; min-width: 0; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis"><strong data-text="chipUser">{v.chipUser}</strong> <span data-text="chipWhat" style="color: #AEB8C7">{v.chipWhat}</span></span>
        </div>
      </div>

      <!-- Right (phone: under the timer): what you'd add -->
      <div class="st-calc">
        <div class="calc-card">
          <p style={`margin: 0; font-family: ${cond}; font-weight: 900; font-style: italic; font-size: clamp(24px, 2cqi, 26px); line-height: 1; text-transform: uppercase`} id="calc-title">Cât adaugi tu?</p>
          <p style="margin: 4px 0 0; font-size: 13px; color: #8C97A8">Alege și vezi unde ajunge timerul.</p>
          <div class="calc-grid" role="radiogroup" aria-labelledby="calc-title" data-region="calcOpts" set:html={views.calcOpts(v)} />
          <div class="calc-row" aria-live="polite">
            <p class="calc-add" data-text="calcAdd">{v.calcAdd}</p>
            <p {...iff('calcAtOn')} style="margin: 4px 0 0; font-size: 13px; color: #AEB8C7">Timerul ar sări la <strong data-text="calcAt" style={`color: #F2F5FA; font-family: ${cond}; font-size: 16px`}>{v.calcAt}</strong></p>
          </div>
          <p style={`margin: 4px 0 0; font-family: ${cond}; font-weight: 800; font-style: italic; font-size: 18px; color: #F2F5FA`}>≈ <span data-text="calcFun">{v.calcFun}</span></p>
          <p {...iff('calcDouble')} style="margin: 4px 0 0; font-size: 13px; font-weight: 700; color: var(--ice)">Ora dublă: acum valorează ×2.</p>
          <a class="btn-primary" href={site.links.donate} style={`margin-top: 12px; min-height: 46px; display: flex; align-items: center; justify-content: center; text-decoration: none; font-family: ${cond}; font-weight: 800; font-size: 20px; text-transform: uppercase`}>Donează</a>
        </div>
      </div>

      <!-- The line -->
      <div class="st-line">
        <div class="display">
          <span class="rule" aria-hidden="true" style="background: linear-gradient(90deg, rgba(63,208,255,0), #3FD0FF)"></span>
          <p>Voi decideți <span class="br"></span><span class="ice-text">cât durează.</span></p>
          <span class="rule" aria-hidden="true" style="background: linear-gradient(90deg, #3FD0FF, rgba(63,208,255,0))"></span>
        </div>
        <p class="sub-line"><span class="sl-long">Fiecare sub și fiecare donație adaugă timp pe cronometru</span><span class="sl-short">Fiecare sub și donație adaugă timp</span></p>
      </div>

      <!-- The timer card -->
      <div class="st-timer">
        <div class="timer-card">
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px">
            <span data-text="timerLabel" style={`font-family: ${cond}; font-weight: 800; font-style: italic; font-size: 18px; letter-spacing: 0.1em; text-transform: uppercase; color: #AEB8C7`}>{v.timerLabel}</span>
            <span data-text="statusText" data-style="background:liveBg" style={`padding: 3px 12px; transform: skewX(-12deg); background: ${v.liveBg}; color: #FFFFFF; font-family: ${cond}; font-weight: 800`}>{v.statusText}</span>
          </div>
          <p {...iff('hasNow')} style="margin: 8px 0 0; font-size: 15px; color: #C9D2DF; overflow-wrap: anywhere"><strong data-text="nowLabel" style={`font-family: ${cond}; letter-spacing: 0.1em; color: var(--ice); margin-right: 8px; text-transform: uppercase`}>{v.nowLabel}</strong><span data-text="nowText">{v.nowText}</span></p>
          <div class="units">
            <span class="pop-tag fx-pop" aria-hidden="true" data-toggle="fxA:fxA;fxB:fxB" data-text="popText">{v.popText}</span>
            {units.map(([key, label], i) => (
              <div>
                <div class="unit-box fx-glow" data-toggle="fxA:fxA;fxB:fxB"><span class="unit-num" data-text={key}>{v[key]}</span><span aria-hidden="true" class="glint" style={`animation-delay: ${i * 0.25}s`}></span></div>
                <div class="unit-label">{label}</div>
              </div>
            ))}
          </div>
          <div class="score">
            <div><p class="lbl">Strâns până acum</p><p class="val" data-text="raisedText">{v.raisedText}</p></div>
            <a id="prezentat" class="sc-sponsor" href="#parteneri" style="text-decoration: none; color: #F2F5FA">
              <p class="lbl">Prezentat de</p>
              <span style="margin-top: 4px; display: flex; align-items: center; gap: 12px">
                {site.sponsor.logo
                  ? <img src={site.sponsor.logo} alt="" width="64" height="44" style="flex: none; width: 64px; height: 44px; object-fit: contain" />
                  : <span class="logo-box" aria-hidden="true">LOGO</span>}
                <span class="sp-name" style="font-weight: 700; font-size: 26px; letter-spacing: 0.06em" data-sponsor="logo">{site.sponsor.logoText}</span>
              </span>
            </a>
            <div><p class="lbl">Următorul milestone</p><p class="val" data-text="nextGoalText" style="color: var(--ice)">{v.nextGoalText}</p></div>
          </div>
          <div class="bar" style="margin-top: 16px" role="img" aria-label={`Spre următorul milestone: ${v.progressLabel}`} data-attr="aria-label:progressAria"><span data-style="width:progressPct" style={`width: ${v.progressPct}`}></span></div>
          <p {...iff('isFrozen')} style="margin: 12px 0 0; font-size: 14px; color: #C9D2DF"><strong style={`font-family: ${cond}; font-weight: 800; font-style: italic; color: var(--ice); letter-spacing: 0.04em`}>ÎNGHEȚAT</strong> <span data-text="frozenText">{v.frozenText}</span></p>
          <p {...iff('hasDouble')} style="margin: 12px 0 0; font-size: 14px; color: #C9D2DF"><strong style={`font-family: ${cond}; font-weight: 800; font-style: italic; color: #FFFFFF; letter-spacing: 0.04em`}>ORA DUBLĂ</strong> <span data-text="doubleText">{v.doubleText}</span></p>
          <div class="rates">
            <span class="rates-title" style={`font-family: ${cond}; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #AEB8C7; margin-right: 6px`}>Cum adaugi timp</span>
            {rateChips.map(([a, b]) => <span class="rate"><strong style="color: #F2F5FA">{a}</strong> = {b}</span>)}
          </div>
          <p class="rates-hint">Cum adaugi timp: rând care se dă cu degetul →</p>
        </div>
      </div>

      <div class="st-cta">
        <div class="cta-row">
          <a class="btn-primary" href={site.links.twitch} style={`font-family: ${cond}; font-weight: 900; font-style: italic; font-size: 24px`}>Urmărește live</a>
          <a class="btn-ghost cta-donate" href={site.links.donate} style={`font-family: ${cond}; font-weight: 800; font-size: 22px`}>Donează / dă un sub</a>
        </div>
      </div>
    </div>
  </div>
</section>
