---
// Line-art plan of Iceman's League of Legends stream (1920×1080) for the sponsor
// presentation. Traced like the real stream: the mid lane and the river, jungle
// walls, brush, an enemy turret, minion waves, his champion (an ice mage), the
// game's HUD (score/timer top-right, abilities bottom-centre, minimap
// bottom-right), his webcam bottom-left and the ICEMARATON overlay top-left
// (the real overlay iframe runs on top). src/scripts/blueprint.ts plays it on
// its own: the waves walk in, he last-hits with his Q, pings come up on the
// minimap and Iceman reacts on camera. One callout (data-focus on the parent
// .scene) marks where the brand appears.
// GENERATED by tools/stream-blueprint/gen.py from template.astro.txt (the ground:
// lane stones, river, walls, grass). Edit the template, then run:
//   python3 tools/stream-blueprint/gen.py src/components/StreamBlueprint.astro tools/stream-blueprint/template.astro.txt

// Lane frame: D along the mid lane, N across it.
const D = [0.85, -0.527], N = [0.527, 0.85];
const off = (dt: number, ds: number) => [dt * N[0] + ds * D[0], dt * N[1] + ds * D[1]];
// Minions are drawn at 1.3× (MS); offsets match ENEMY_OFF in scripts/blueprint.ts.
const MS = 1.3;
const wave = (dir: 1 | -1) => [
  { o: off(-36, 0), m: true }, { o: off(0, 0), m: true }, { o: off(36, 0), m: true },
  { o: off(-23, -44 * dir), m: false }, { o: off(23, -44 * dir), m: false }, { o: off(0, -70 * dir), m: false },
];
const fx = (v: number) => Math.round(v * 10) / 10;

// Minimap (origin 1644,804; 254 px square).
const mm = (x: number, y: number) => [1644 + x, 804 + y];
const blob = (x: number, y: number, r: number, seed: number) => {
  const k = 7, p = [];
  for (let i = 0; i < k; i++) {
    const a = (2 * Math.PI * i) / k + Math.sin(seed + i) * 0.3, rr = r * (0.75 + 0.25 * Math.abs(Math.sin(seed * 3 + i * 1.7)));
    const [px, py] = mm(x + rr * Math.cos(a), y + rr * Math.sin(a) * 0.8);
    p.push(`${fx(px)} ${fx(py)}`);
  }
  return `M${p.join(' L')} Z`;
};
const walls = [[45, 92, 13], [62, 160, 14], [92, 196, 11], [130, 48, 13], [96, 38, 9], [172, 70, 12], [112, 208, 12], [162, 214, 11], [206, 118, 13], [214, 164, 12], [188, 96, 9]];
const towersBlue = [[16, 150], [16, 92], [96, 238], [156, 238], [70, 184], [96, 158]];
const towersRed = [[104, 16], [164, 16], [238, 104], [238, 162], [184, 70], [158, 96]];
const allies = [[105, 149, 1], [16, 124, 0], [62, 132, 0], [150, 232, 0], [166, 238, 0]];
const enemies = [[140, 116], [62, 16], [200, 110], [238, 150], [232, 168]];
