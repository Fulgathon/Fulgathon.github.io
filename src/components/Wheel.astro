---
// 03 Roata lui Lucky.
import SectionHead from './SectionHead.astro';
import Emote from './Emote.astro';
import { v, iff } from '../lib/ssr';
import { views } from '../lib/views';
import { defaultPrizes } from '../data/content';
const cond = "'Barlow Condensed', sans-serif";

const rim = Array.from({ length: 48 }, (_, i) => {
  const a = (i / 48) * Math.PI * 2;
  const major = i % 6 === 0;
  return {
    left: (50 + 47.7 * Math.sin(a)).toFixed(2) + '%', top: (50 - 47.7 * Math.cos(a)).toFixed(2) + '%',
    w: major ? '0.7cqi' : '0.35cqi', h: major ? '2.6cqi' : '1.4cqi',
    ml: major ? '-0.35cqi' : '-0.175cqi', mt: major ? '-1.3cqi' : '-0.7cqi',
    rot: (i * 7.5).toFixed(1),
    color: major ? '#F2F5FA' : '#4A5563',
  };
});
const ruleNum = `font-family: ${cond}; font-weight: 900; font-style: italic; font-size: 22px; color: var(--ice); width: 24px`;
const emoteStyle = 'flex: none; width: 44px; height: 54px; object-fit: contain';
---
<section id="roata" aria-labelledby="h-roata" style="position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: clamp(56px, 8cqi, 112px) clamp(20px, 4cqi, 40px)">
  <SectionHead tag="03" bignum="03" title="Roata lui Lucky" id="h-roata">
    <div style="max-width: 420px">
      <p style="margin: 0; font-size: 17px; color: #AEB8C7">Abonații care stau, câștigă: 2 ore pe stream într-o zi înseamnă o rotire.</p>
      <p style="margin: 12px 0 0; display: flex; align-items: center; gap: 12px; font-size: 13px; color: #8C97A8">Premii oferite de <span class="logo-slot" style="width: 120px; height: 34px; font-size: 11px">Logo sponsor</span></p>
    </div>
  </SectionHead>
  <div style="margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: clamp(32px, 5cqi, 72px)">
    <div style="flex: 1 1 360px; min-width: 0; max-width: 500px; margin: 0 auto">
      <div data-toggle="is-spinning:spinning" aria-hidden="true" style="position: relative; width: 100%; aspect-ratio: 1 / 1; container-type: inline-size">
        <div style="position: absolute; left: 50%; top: -10px; transform: translateX(-50%); z-index: 3; width: 0; height: 0; border-left: 16px solid transparent; border-right: 16px solid transparent; border-top: 30px solid var(--ice); filter: drop-shadow(0 0 8px rgba(63,208,255,0.6))"></div>
        <div class="wheel" data-style="transform:wheelTransform" style={`position: absolute; inset: 0; border-radius: 50%; border: 4.6cqi solid #0B0F15; box-shadow: 0 0 0 1px #3A4452, inset 0 0 0 1px #3A4452, 0 0 0 6px #050608, 0 0 0 7px #2A3340, 0 0 90px rgba(63,208,255,0.18); overflow: hidden; transform: ${v.wheelTransform}; background: repeating-conic-gradient(rgba(242,245,250,0.22) 0deg 0.7deg, rgba(0,0,0,0) 0.7deg 45deg), conic-gradient(#0A0F16 0deg 45deg, #102233 45deg 90deg, #0A0F16 90deg 135deg, #17456A 135deg 180deg, #0A0F16 180deg 225deg, #102233 225deg 270deg, #0A0F16 270deg 315deg, #161C25 315deg 360deg)`} data-region="wheelPrizes" set:html={views.wheelPrizes(v)} />
        {rim.map((rb) => (
          <span class="tick" style={`left: ${rb.left}; top: ${rb.top}; width: ${rb.w}; height: ${rb.h}; margin-left: ${rb.ml}; margin-top: ${rb.mt}; transform: rotate(${rb.rot}deg); background: ${rb.color}`}></span>
        ))}
        <div style="position: absolute; left: 50%; top: 50%; width: 25%; aspect-ratio: 1 / 1; transform: translate(-50%, -50%); z-index: 2; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #1A222D 0%, #07090D 70%); border: 2px solid var(--ice); box-shadow: 0 0 30px rgba(63,208,255,0.35); display: grid; place-items: center">
          <Emote style="width: 70%; height: auto" />
        </div>
      </div>
      <p class="sr-only">Premiile de pe roată: {defaultPrizes.map((p) => p[1]).join(', ')}.</p>
    </div>

    <div style="flex: 1 1 420px; min-width: 0">
      <h3 style={`margin: 0; font-family: ${cond}; font-weight: 800; font-size: 24px; text-transform: uppercase`}>Cum primești rotiri</h3>
      <ul style="list-style: none; margin: 12px 0 0; padding: 0">
        <li style="display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid #1A2230"><span style={ruleNum}>1</span><span>Trebuie să fii <strong>abonat</strong> pe Twitch.</span></li>
        <li style="display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid #1A2230"><span style={ruleNum}>2</span><span>Uită-te la stream <strong>cel puțin 2 ore</strong> în aceeași zi. Se numără automat cât stai în chat; fiecare fulg = 30 de minute.</span></li>
        <li style="display: flex; gap: 14px; padding: 12px 0; border-bottom: 1px solid #1A2230"><span style={ruleNum}>3</span><span><strong>O rotire pe zi</strong>, până la finalul maratonului. Ziua începe la 00:00.</span></li>
      </ul>

      <div style="margin-top: 24px; padding: 20px; background: #0B1018; border: 1px solid #1A2230">
        <div {...iff('isIn')}>
          <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px">
            <p data-text="spinsText" style={`margin: 0; font-family: ${cond}; font-weight: 900; font-style: italic; font-size: 34px; line-height: 1; text-transform: uppercase`}>{v.spinsText}</p>
            <div role="img" aria-label={v.flakesLabel} data-attr="aria-label:flakesLabel" data-region="flakes" style="display: flex; align-items: center; gap: 6px" set:html={views.flakes(v)} />
          </div>
          <p data-text="flakesNote" style="margin: 6px 0 0; font-size: 15px; color: #8C97A8">{v.flakesNote}</p>
        </div>
        <p {...iff('isOut')} style="margin: 0; font-size: 16px; color: #AEB8C7">Conectează-te cu Twitch ca să vezi cât ai privit azi și dacă ai rotire.</p>
        <button type="button" class={v.spinClass} data-attr="class:spinClass" data-action="spin" data-text="spinLabel" style={`margin-top: 16px; width: 100%; min-height: 58px; font-family: ${cond}; font-weight: 900; font-style: italic; font-size: 24px; text-transform: uppercase; letter-spacing: 0.02em`}>{v.spinLabel}</button>
        <div role="status">
          <div {...iff('hasResult')} style="margin-top: 16px; display: flex; align-items: center; gap: 14px; padding: 14px; border: 2px solid var(--ice)">
            <Emote style={emoteStyle} />
            <div>
              <p data-text="resultTitle" style={`margin: 0; font-family: ${cond}; font-weight: 900; font-style: italic; font-size: 24px; line-height: 1.1; text-transform: uppercase`}>{v.resultTitle}</p>
              <p data-text="resultNote" style="margin: 2px 0 0; font-size: 15px; color: #AEB8C7">{v.resultNote}</p>
            </div>
          </div>
        </div>
      </div>

      <h3 style={`margin: 28px 0 0; font-family: ${cond}; font-weight: 800; font-size: 20px; text-transform: uppercase; color: #AEB8C7`}>Ultimele premii</h3>
      <ul data-region="recentWins" style="list-style: none; margin: 8px 0 0; padding: 0; font-size: 15px" set:html={views.recentWins(v)} />
    </div>
  </div>
</section>
