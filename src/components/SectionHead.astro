---
// Section heading (layout v2): skewed ice number tag, big italic title, 2px
// white rule; an optional line on the right (desktop) or under it (phone).
interface Props { tag: string; title: string; id?: string }
const { tag, title, id } = Astro.props;
---
<div class="shead">
  <div>
    <span class="tag-ice" style="font-size: 15px">{tag}</span>
    <h2 id={id}>{title}</h2>
  </div>
  <slot />
</div>
