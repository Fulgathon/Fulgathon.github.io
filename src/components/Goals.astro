---
// 05 Milestone Maraton: challenges unlocked by the donation total (€), set by the streamer on /mod.
import SectionHead from './SectionHead.astro';
import { v } from '../lib/ssr';
import { views } from '../lib/views';
---
<section id="goals" aria-labelledby="h-goals" style="position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding: 0 clamp(20px, 4cqi, 40px) clamp(56px, 8cqi, 112px)">
  <SectionHead tag="06" bignum="06" title="Milestone Maraton" id="h-goals">
    <div>
      <p style="margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 24px; text-transform: uppercase"><span data-text="unlockedCount" style="color: var(--ice)">{v.unlockedCount}</span> din <span data-text="totalGoals">{v.totalGoals}</span> deblocate</p>
      <p style="margin: 4px 0 0; max-width: 420px; font-size: 16px; color: #AEB8C7">Provocări deblocate de donații. Când totalul strâns atinge suma, Iceman o face live.</p>
    </div>
  </SectionHead>
  <div class="g-goals" data-region="goals" style="display: grid" set:html={views.goals(v)} />
</section>
