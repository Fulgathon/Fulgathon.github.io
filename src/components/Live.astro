---
// 05 Live: the Twitch player and chat, loaded only on request (most visitors
// already have the stream open on Twitch). app.ts swaps in the embeds with the
// right parent= for whatever domain the site is on.
import SectionHead from './SectionHead.astro';
import { iff } from '../lib/ssr';
const cond = "'Barlow Condensed', sans-serif";
---
<section id="live" aria-labelledby="h-live" class="sec">
  <div class="wrap">
    <SectionHead tag="05" title="Live" id="h-live">
      <button class="btn-ghost" type="button" data-action="popout" style={`min-height: 44px; display: inline-flex; align-items: center; gap: 8px; padding: 0 16px; font-family: ${cond}; font-size: 17px; font-weight: 700; text-transform: uppercase`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6"></path></svg>
        Player separat
      </button>
    </SectionHead>
    <div class="live-grid">
      <div id="player-slot" class="panel" style="position: relative; aspect-ratio: 16 / 9; overflow: hidden">
        <button type="button" {...iff('playerOff')} data-action="player" style="position: absolute; inset: 0; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; background: transparent; border: 0; color: #8C97A8">
          <span style="width: 72px; height: 72px; display: grid; place-items: center; background: var(--ice); color: #04101A">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4v16l13-8z"></path></svg>
          </span>
          <span style={`font-family: ${cond}; font-weight: 800; font-size: 20px; text-transform: uppercase; color: #F2F5FA`}>Pornește playerul</span>
          <span style="font-size: 14px">Playerul Twitch se încarcă doar când apeși.</span>
        </button>
      </div>
      <aside class="panel live-chat" aria-label="Chat" style="min-height: 300px; display: flex; flex-direction: column">
        <div style={`padding: 12px 16px; border-bottom: 1px solid #1A2230; font-family: ${cond}; font-size: 17px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em`}>Chatul stream-ului</div>
        <div id="chat-slot" style="flex: 1 1 auto; display: grid; place-items: center; padding: 20px; text-align: center; font-size: 14px; color: #8C97A8">Chatul apare odată cu playerul.</div>
      </aside>
    </div>
  </div>
</section>
