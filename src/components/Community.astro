---
// 02 Comunitatea, three rows read top to bottom:
//   1. one band: Contribuția ta (time added, stats, badges with tooltips); the community goal was deleted (owner, 24 Nov)
//   2. Legende: three equal panels (place 1 prism, 2/3/4 gold/silver/bronze, 5 grey)
//   3. Fidelii
// Names come through public_name() (moderation + opt-out, toggle at the bottom).
import SectionHead from './SectionHead.astro';
import { v, iff } from '../lib/ssr';
import { views } from '../lib/views';
const cond = "'Barlow Condensed', sans-serif";
const small = `font-family: ${cond}; font-weight: 800; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; color: #8C97A8`;
---
<section id="comunitate" aria-labelledby="h-comunitate" class="sec">
  <!-- Shared gradients for the prism badges -->
  <svg width="0" height="0" aria-hidden="true" style="position: absolute"><defs>
    <linearGradient id="g-prism" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9FE8FF"></stop><stop offset="0.3" stop-color="#A9B8FF"></stop><stop offset="0.52" stop-color="#E2B6FF"></stop><stop offset="0.74" stop-color="#FFD6C2"></stop><stop offset="1" stop-color="#C8FFE9"></stop></linearGradient>
    <linearGradient id="g-prism-fill" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9FE8FF" stop-opacity="0.22"></stop><stop offset="0.5" stop-color="#E2B6FF" stop-opacity="0.16"></stop><stop offset="1" stop-color="#C8FFE9" stop-opacity="0.22"></stop></linearGradient>
  </defs></svg>
  <div class="wrap">
    <SectionHead tag="01" title="Comunitatea" id="h-comunitate">
      <p class="side">Ce ai adăugat tu și cine conduce.</p>
    </SectionHead>

    <!-- Row 1: you -->
    <div class="band band-one panel">
      <div>
        <p class="eyebrow-s">Contribuția ta</p>
        <div {...iff('isOut')}>
          <p style="margin: 6px 0 0; color: #C9D2DF">Conectează-te cu Twitch: vezi timpul tău, seria și insignele.</p>
          <button type="button" class="btn-twitch" data-action="login" style={`margin-top: 12px; min-height: 48px; padding: 0 20px; font-family: ${cond}; font-weight: 800; font-size: 17px; text-transform: uppercase`}>Conectează-te cu Twitch</button>
        </div>
        <div {...iff('isIn')} style="margin-top: 6px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 16px">
          <span class="big-num" data-text="mineHead">{v.mineHead}</span>
          <span data-text="mineLine" style="font-size: 14px; color: #AEB8C7">{v.mineLine}</span>
        </div>
        <p style={`margin: 16px 0 8px; ${small}`}>Insignele tale · <span data-text="myBadgesCount">{v.myBadgesCount}</span> <span class="hide-sm" style="font-family: Barlow, sans-serif; font-weight: 400; letter-spacing: 0; text-transform: none; color: #7D8899">· treci cu mouse-ul peste una ca să vezi cum o obții</span></p>
        <div class="badges-row" data-region="myBadges" set:html={views.myBadges(v)} />
        <div class="tip-panel" data-toggle="on:tipOn" aria-live="polite">
          <p data-text="tipLabel" style={`margin: 0; font-family: ${cond}; font-weight: 800; font-size: 15px; color: #8FE4FF`}>{v.tipLabel}</p>
          <p style="margin: 2px 0 0; font-size: 13px; line-height: 1.35; color: #E6EBF1"><strong style="color: #8C97A8">Cum o obții:</strong> <span data-text="tipHow">{v.tipHow}</span></p>
          <p data-text="tipWho" style="margin: 4px 0 0; font-size: 12px; color: #8C97A8">{v.tipWho}</p>
        </div>
        <p class="show-sm" style="margin: 6px 0 0; font-size: 12px; color: #7D8899">Atinge o insignă ca să vezi cum o obții.</p>
        <p {...iff('isIn')} data-text="mineNote" style="margin: 12px 0 0; font-size: 13px; color: #AEB8C7">{v.mineNote}</p>
      </div>
    </div>

    <!-- Row 2: legends -->
    <h3 style={`margin: var(--gap-group) 0 0; font-family: ${cond}; font-weight: 900; font-style: italic; font-size: clamp(26px, 2.4cqi, 34px); text-transform: uppercase`}>Legende <span class="h3-meta"><span class="h3-dot" aria-hidden="true">· </span>top 5, totaluri adunate pe tot maratonul</span></h3>
    <div class="legends" data-region="legends" set:html={views.legends(v)} />
    <p class="lg-dots">Se dau cu degetul: Donatori · Subs dăruite · Biți</p>

    <!-- Row 3: the regulars -->
    <div class="duo duo-one">
      <div class="panel">
        <div style="display: flex; align-items: baseline; justify-content: space-between; gap: 12px">
          <h3 class="h3">Fidelii</h3>
          <span style={`font-family: ${cond}; font-weight: 800; font-size: 16px; letter-spacing: 0.08em; color: #8C97A8`}>ORE ÎN CHAT</span>
        </div>
        <p style="margin: 2px 0 0; font-size: 14px; color: #8C97A8">O zi se numără de la 30 de minute sau un check-in.</p>
        <ol class="rows ly" aria-label="Fidelii" data-region="loyal" set:html={views.loyal(v)} />
        <p style="margin: 12px 0 0; font-size: 13px; color: #AEB8C7"><strong style="color: var(--ice)">Check-in:</strong> recompensa «Check-in ICEMARATON» pe Twitch îți ține seria.</p>
      </div>
    </div>
  </div>
</section>
