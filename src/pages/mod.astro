      details.more > :last-child { margin-bottom: 16px; }
      details.more > summary + * { margin-top: 14px; }

      /* Top bar and menu */
      .mbar { background: rgba(9, 12, 18, .94); border-bottom-color: var(--ln); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
