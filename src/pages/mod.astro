      button:disabled, .btn-primary:disabled, .btn-ghost:disabled { opacity: .45; cursor: not-allowed; box-shadow: none; }
      .btn-primary:disabled { background: #1A3A4D; border-color: #1A3A4D; color: #8FB8CC; opacity: 1; }
      .btn-s { min-height: 40px; padding: 0 14px; font-size: 14px; }
      .btn-link { background: transparent; border: 1px solid transparent; color: #8FE4FF; padding: 0 10px; }
      .btn-link:hover { color: #FFFFFF; background: rgba(63, 208, 255, .08); }
      .btn-link svg { transition: transform .2s var(--ease); } .btn-link:hover svg { transform: translateX(3px); }
      .mbar .btn-ghost { min-height: 40px; }
      .sp-mv { width: 44px; padding: 0; }

      /* Pills: tinted, with a hairline; the LIVE tag in the bar stays solid red. */
      .pill { display: inline-flex; align-items: center; min-height: 22px; padding: 0 8px; font-size: 12px; letter-spacing: .08em; line-height: 1; vertical-align: middle; font-style: normal; white-space: nowrap; }
      .pill.ok { background: rgba(63, 208, 255, .12); color: #8FE4FF; box-shadow: inset 0 0 0 1px rgba(63, 208, 255, .35); }
      .pill.warn { background: rgba(242, 193, 78, .10); color: #F2C14E; box-shadow: inset 0 0 0 1px rgba(242, 193, 78, .35); }
      .pill.bad { background: rgba(213, 22, 43, .16); color: #FF8A95; box-shadow: inset 0 0 0 1px rgba(255, 90, 110, .4); }
      .pill.off { background: #111823; color: var(--tx2); box-shadow: inset 0 0 0 1px var(--ln3); }
      .pill.white { background: rgba(242, 245, 250, .08); color: #F2F5FA; box-shadow: inset 0 0 0 1px rgba(242, 245, 250, .35); }
      .pill.next { border: 0; box-shadow: inset 0 0 0 1px var(--ice); }
      .mbar .pill.bad { background: #D5162B; color: #FFFFFF; box-shadow: none; min-height: 26px; padding: 0 10px; font-size: 14px; }
      .pill.unsaved { background: #F2C14E; color: #1A1300; box-shadow: none; margin-left: 0; }
      .pill-s { display: inline-flex; align-items: center; min-height: 26px; padding: 0 10px; background: rgba(63, 208, 255, .08); border-color: rgba(63, 208, 255, .3); }
      .sp-flags { gap: 6px; margin-top: 6px; }

      /* (i) explanations: a 22 px square with a 44 px hit area; one floating box for all. */
      .tip { position: relative; flex: none; width: 22px; height: 22px; min-height: 0; padding: 0; display: inline-grid; place-items: center; vertical-align: middle; background: transparent; border: 1px solid var(--ln3); color: var(--tx3); cursor: help; transform: none; font-style: normal; transition: color .15s ease, border-color .15s ease, background-color .15s ease; }
      .tip::after { content: ''; position: absolute; inset: -11px; }
      .row:has(> label.inline) > .tip, .fgrid > .tip { margin-bottom: 11px; }   /* level with the 44 px controls */
      .tip:hover, .tip[aria-expanded="true"] { color: var(--ice); border-color: var(--ice); background: rgba(63, 208, 255, .08); }
      .tip:focus-visible { outline: none; box-shadow: var(--ring); }
      button.tip:active:not(:disabled) { transform: none; }
      #tipBox { position: fixed; z-index: 80; left: 0; top: 0; width: max-content; max-width: min(340px, calc(100vw / var(--z, 1) - 24px)); padding: 10px 12px; background: #0F1620; border: 1px solid #2A3F5A; box-shadow: 0 16px 40px rgba(0, 0, 0, .65); color: #DCE3EC; font: 400 13.5px/1.55 Barlow, system-ui, sans-serif; letter-spacing: normal; text-transform: none; white-space: pre-line; pointer-events: none; }
      #tipBox::before { content: ''; position: absolute; left: calc(var(--ax, 50%) - 5px); width: 8px; height: 8px; background: #0F1620; border: solid #2A3F5A; transform: rotate(45deg); }
      #tipBox[data-side="below"]::before { top: -5px; border-width: 1px 0 0 1px; }
      #tipBox[data-side="above"]::before { bottom: -5px; border-width: 0 1px 1px 0; }
      @media (prefers-reduced-motion: no-preference) { #tipBox:not([hidden]) { animation: tipIn .16s var(--ease); } @keyframes tipIn { from { opacity: 0; transform: translateY(3px); } } }

      /* Details (manual vote round) */
      details.more { border: 1px solid var(--ln2); background: var(--bg2); }
      details.more > summary { min-height: 52px; display: flex; align-items: center; padding: 0 16px; cursor: pointer; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: .06em; text-transform: uppercase; }
      details.more > summary:hover { color: #FFFFFF; background: var(--bg3); }
