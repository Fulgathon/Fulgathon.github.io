---
// Moderator page: run the subathon from here. Not linked from the public
// page and not indexed. Everything on it needs a Twitch login with a
// moderator account; the database checks that on every action.
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow-condensed/900-italic.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import emote from '../../assets/emote.png';
const favicon = await getImage({ src: emote, format: 'png', width: 64 });
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Moderatori · FULGATHON</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    <style is:global>
      body { color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
      .wrap { max-width: 1100px; margin: 0 auto; padding: 24px clamp(16px, 4vw, 40px) 80px; }
      header.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-bottom: 16px; border-bottom: 2px solid #F2F5FA; }
      h1 { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(30px, 5vw, 46px); text-transform: uppercase; line-height: 1; }
      h1 span { color: var(--ice); }
      h2 { margin: 0 0 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 22px; text-transform: uppercase; letter-spacing: .04em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 16px; margin-top: 20px; }
      .card { background: #0B1018; border: 1px solid #1A2230; padding: 18px; }
      .card.wide { grid-column: 1 / -1; }
      .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; }
      .muted { color: #8C97A8; font-size: 14px; }
      .big { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 40px; line-height: 1; }
      .pill { display: inline-block; padding: 2px 8px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
      .ok { background: var(--ice); color: #04101A; } .bad { background: #D5162B; color: #fff; } .off { background: #2A3445; color: #C9D2DF; }
      button, .btn { min-height: 44px; padding: 0 14px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 16px; text-transform: uppercase; letter-spacing: .03em; text-decoration: none; display: inline-flex; align-items: center; }
      .field { min-height: 44px; padding: 0 10px; }
      input.field[type="number"] { width: 90px; }
      label.inline { display: inline-flex; flex-direction: column; gap: 4px; font-size: 13px; color: #AEB8C7; font-weight: 600; }
      ul.list { list-style: none; margin: 8px 0 0; padding: 0; }
      ul.list li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 10px 0; border-bottom: 1px solid #1A2230; }
      ul.list li .grow { flex: 1 1 220px; min-width: 0; }
      select.field { max-width: 100%; }
      .msg { position: fixed; right: 16px; bottom: 16px; z-index: 30; max-width: min(420px, calc(100% - 32px)); padding: 12px 16px; background: #0B1018; border: 2px solid var(--ice); box-shadow: 8px 8px 0 #000; }
      .msg.err { border-color: #D5162B; }
    </style>
  </head>
  <body>
    <div class="wrap">
      <header class="top">
        <h1>FULGATHON <span>· Moderatori</span></h1>
        <div class="row" id="who" style="margin: 0"></div>
      </header>
      <main id="app" aria-live="polite"><p class="muted" style="margin-top: 20px">Se încarcă…</p></main>
    </div>
    <div class="msg" id="msg" role="status" hidden></div>
    <script>
      import '../scripts/mod';
    </script>
  </body>
</html>
