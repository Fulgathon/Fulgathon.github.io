---
// Moderator page: run the subathon from here. Not linked from the public
// page and not indexed. Everything on it needs a Twitch login with a
// moderator account; the database checks that on every action.
import '../styles/fonts.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import emote from '../../assets/emote.png';
const favicon = await getImage({ src: emote, format: 'png', width: 64 });
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Moderatori · ICEMARATON</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    <style is:global>
      body { color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
      h1 { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(30px, 5vw, 46px); text-transform: uppercase; line-height: 1; }
      h1 span { color: var(--ice); }
      h2 { margin: 0 0 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 22px; text-transform: uppercase; letter-spacing: .04em; }
      .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 16px; margin-top: 20px; }
      .card { background: #0B1018; border: 1px solid #1A2230; padding: 18px; }
      .card.wide { grid-column: 1 / -1; }
      .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; }
      .muted { color: #8C97A8; font-size: 14px; }
      .big { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 40px; line-height: 1; }
      .pill { display: inline-block; padding: 2px 8px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: .06em; text-transform: uppercase; }
      .ok { background: var(--ice); color: #04101A; } .bad { background: #D5162B; color: #fff; } .off { background: #2A3445; color: #C9D2DF; } .warn { background: #F2C14E; color: #1A1300; }
      .health li { align-items: flex-start; } .health .pill { flex: none; min-width: 64px; text-align: center; margin-top: 2px; }
      button, .btn { min-height: 44px; padding: 0 14px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 16px; text-transform: uppercase; letter-spacing: .03em; text-decoration: none; display: inline-flex; align-items: center; }
      .field { min-height: 44px; padding: 0 10px; }
      input.field[type="number"] { width: 90px; }
      label.inline { display: inline-flex; flex-direction: column; gap: 4px; font-size: 13px; color: #AEB8C7; font-weight: 600; }
      ul.list { list-style: none; margin: 8px 0 0; padding: 0; }
      ul.list li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 10px 0; border-bottom: 1px solid #1A2230; }
      ul.list li .grow { flex: 1 1 220px; min-width: 0; }
      select.field { max-width: 100%; }
      .msg { position: fixed; right: 16px; bottom: 16px; z-index: 30; max-width: min(420px, calc(100% - 32px)); padding: 12px 16px; background: #0B1018; border: 2px solid var(--ice); box-shadow: 8px 8px 0 #000; }
      .msg.err { border-color: #D5162B; }
      .pair { display: flex; gap: 8px; align-items: center; }
      .quick { display: flex; flex-wrap: wrap; gap: 8px; }
      /* Phones: full-width controls, inputs share a row with their button. */
      @media (max-width: 640px) {
            .card { padding: 16px 14px; }
        .big { font-size: 34px; }
          .row > *, .pair { flex: 1 1 auto; justify-content: center; }
        .row > .muted { flex-basis: 100%; }
        .pair { width: 100%; }
        .pair .field, .row > .field { flex: 1 1 0; min-width: 0; width: auto; }
        .pair button { flex: none; justify-content: center; }
        input.field[type="number"] { width: auto; }
        label.inline { flex: 1 1 140px; }
        label.inline .field { width: 100%; }
        select.field { width: 100%; }
        .quick { display: grid; grid-template-columns: repeat(4, 1fr); width: 100%; }
        .quick button { justify-content: center; padding: 0 6px; }
        ul.list li .grow { flex: 1 1 0; }
        #provocari ul.list li .grow, #propuneri ul.list li .grow { flex-basis: 100%; }
        #milestones ul.list li .pair { flex: 1 1 100%; }
        #milestones ul.list li .pair input[data-goal-amt] { flex: 0 0 90px !important; width: 90px !important; }
        ul.list li.acts-row button { flex: 1 1 0; justify-content: center; }
      }
      /* ---- /mod v2: status bar, grouped menu, pages (design/layout-v2/ModLive + ModContent + ModPhone) ---- */
      .mbar { position: sticky; top: 0; z-index: 25; min-height: 64px; padding: 8px 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; background: #0B1018; border-bottom: 1px solid #1C2230; }
      .mbar .brand { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 22px; color: #F2F5FA; text-decoration: none; white-space: nowrap; }
      .mbar .brand span { color: var(--ice); }
      .mbar .brand small { font-style: normal; font-weight: 800; font-size: 14px; letter-spacing: .1em; color: #8C97A8; }
      .mbar .sep { width: 1px; height: 32px; background: #1C2230; }
      .mbar .grow { flex: 1 1 auto; }
      .skew { transform: skewX(-12deg); }
      .bar-clock { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 30px; line-height: 1; font-variant-numeric: tabular-nums; }
      .chip { padding: 3px 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .05em; white-space: nowrap; }
      .chip.run { border: 1px solid var(--ice); color: #8FE4FF; }
      .chip.frost { background: #0E1A28; border: 1px solid #8FE4FF; color: #DFF6FF; }
      .chip.dbl { background: #F2F5FA; color: #04101A; }
      .hdots { display: flex; flex-wrap: wrap; gap: 4px 14px; text-decoration: none; color: #C9D2DF; font-size: 13px; }
      .hd { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
      .dot { width: 9px; height: 9px; display: inline-block; }
      .dot.ok { background: var(--ice); } .dot.warn { background: #F2C14E; } .dot.bad { background: #D5162B; } .dot.off { background: #4A5568; }
      .who { display: inline-flex; align-items: center; gap: 10px; }
      .avatar { width: 30px; height: 30px; display: grid; place-items: center; background: #9146FF; font-weight: 700; }
      .who-n { font-weight: 600; font-size: 14px; }
      .mshell { display: grid; grid-template-columns: 248px minmax(0, 1fr); min-height: calc(100vh - 64px); }
      .mnav { position: sticky; top: var(--bar-h, 64px); align-self: start; max-height: calc(100vh - var(--bar-h, 64px)); overflow-y: auto; padding: 14px 12px; display: flex; flex-direction: column; gap: 10px; background: #050608; border-right: 1px solid #1C2230; }
      .mnav[hidden] { display: none; }
      .mnav[hidden] + .mmain { grid-column: 1 / -1; max-width: 720px; }
      .ng { background: #06080C; border: 1px solid #161B26; }
      .ng.on { background: #090D14; border-color: #2A3F5A; }
      /* Prism on dark (owner-approved): near-black bar, faint tint on the left, prism letters, 1px prism hairline. */
      .ng-head { min-height: 44px; display: flex; align-items: center; gap: 10px; padding: 0 12px; text-decoration: none; color: #C3B8FF; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .14em;
        background: linear-gradient(90deg, rgba(159,232,255,.10) 0%, rgba(169,184,255,.04) 40%, rgba(0,0,0,0) 75%), #030406;
        border-bottom: 1px solid transparent; border-image: linear-gradient(90deg, rgba(159,232,255,.7), rgba(169,184,255,.7) 30%, rgba(226,182,255,.7) 52%, rgba(255,214,194,.7) 74%, rgba(200,255,233,.7)) 1; }
      .ng.on .ng-head { color: #9FE8FF; background: linear-gradient(90deg, rgba(159,232,255,.16) 0%, rgba(226,182,255,.07) 45%, rgba(0,0,0,0) 80%), #030406;
        border-image: linear-gradient(90deg, #9FE8FF 0%, #A9B8FF 30%, #E2B6FF 52%, #FFD6C2 74%, #C8FFE9 100%) 1; }
      .prism-text { background: linear-gradient(90deg, #9FE8FF 0%, #A9B8FF 30%, #E2B6FF 52%, #FFD6C2 74%, #C8FFE9 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
      .ng-items { padding: 4px 0; }
      .ng-items a { min-height: 44px; display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 12px 0 35px; border-left: 3px solid transparent; color: #C9D2DF; text-decoration: none; font-size: 14px; }
      .ng-items a:hover { color: #FFFFFF; background: rgba(63,208,255,.06); }
      .ng-items a.cur { border-left-color: var(--ice); background: rgba(63,208,255,.10); color: #FFFFFF; font-weight: 700; }
      .nb { min-width: 22px; padding: 0 6px; background: var(--ice); color: #04101A; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; text-align: center; }
      .nb.warn { background: #F2C14E; }
      .mmain { padding: 24px 28px 80px; min-width: 0; }
      .page-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 20px; padding-bottom: 12px; border-bottom: 2px solid #F2F5FA; }
      .page-head h1 { margin: 8px 0 0; font-size: clamp(34px, 4vw, 48px); line-height: .95; }
      .page-head p { margin: 0; max-width: 420px; }
      .tag-ice { display: inline-block; padding: 2px 10px; transform: skewX(-12deg); background: var(--ice); color: #04101A; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; }
      .live-cols { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 16px; align-items: start; margin-top: 20px; }
      .live-cols > .grid { margin-top: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); }
      .aside { display: grid; gap: 16px; }
      .card-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; }
      .card-head h2 { margin-bottom: 8px; }
      .units { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin-top: 4px; }
      .unit { text-align: center; }
      .unit-v { padding: 8px 0 4px; background: linear-gradient(180deg, #16304A, #0B1A2A); border: 1px solid #23415E; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: clamp(40px, 5vw, 64px); line-height: .9; color: #DFF6FF; font-variant-numeric: tabular-nums; }
      .unit-l { margin-top: 4px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: .12em; color: #8C97A8; }
      .todo { border: 2px solid var(--ice); }
      .todo-i { padding-top: 10px; margin-top: 10px; border-top: 1px solid #1A2230; }
      .todo-i p { margin: 0; }
      .todo-i .row { margin-top: 6px; }
      .pill.white { background: #F2F5FA; color: #04101A; } .pill.next { border: 1px solid var(--ice); color: #8FE4FF; }
      .feed li { flex-wrap: nowrap; } .feed .ft { flex: none; min-width: 64px; font-family: 'Barlow Condensed', sans-serif; font-size: 17px; color: var(--ice); }
      .ms-list li.pending { background: rgba(242,193,78,.06); }
      .ms-headrow { display: none; }
      .ms-na { color: #4A5568; }
      @media (min-width: 1200px) {
        ul.ms-list li, .ms-headrow { display: grid; grid-template-columns: 30px 90px minmax(0, 1.6fr) minmax(0, .9fr) 112px minmax(0, 1fr) minmax(0, 1.3fr) 150px 84px; gap: 8px; align-items: center; }
        .ms-headrow { padding: 8px 0; border-bottom: 1px solid #1C2230; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: .1em; color: #8C97A8; }
        ul.ms-list li { padding: 6px 0; }
        ul.ms-list li .field { width: 100%; min-width: 0; }
        .ms-list li button { justify-content: center; padding: 0 8px; }
      }
      @media (max-width: 1199px) { .ms-list li .field { flex: 1 1 160px; min-width: 0; } .ms-list li input[data-goal-amt] { flex: 0 0 90px; } .ms-na { display: none; } }
      .ms-no { flex: none; width: 30px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 22px; color: #8FE4FF; }
      .advent-wrap { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 16px; align-items: start; margin-top: 8px; }
      .ad-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 6px; }
      .ad { min-height: 78px; padding: 7px 8px; display: flex; flex-direction: column; align-items: flex-start; gap: 1px; background: #080B10; border: 1px solid #1C2230; color: #F2F5FA; text-align: left; text-transform: none; letter-spacing: 0; font-family: Barlow, sans-serif; font-weight: 400; }
      .ad.past { background: #0B1018; border-color: #23415E; } .ad.today { background: #0E1A28; border-color: var(--ice); } .ad.sel { background: rgba(63,208,255,.14); border: 2px solid var(--ice); }
      .ad-d { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 12px; letter-spacing: .06em; color: #8C97A8; }
      .ad-n { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 22px; line-height: 1; color: #6B7689; }
      .ad.past .ad-n, .ad.sel .ad-n { color: var(--ice); } .ad.today .ad-n { color: #FFFFFF; }
      .ad-t { margin-top: auto; font-size: 11px; line-height: 1.2; color: #C9D2DF; }
      .ad-edit { padding: 16px 18px; background: #080B10; border: 2px solid var(--ice); display: grid; gap: 10px; }
      .ad-edit label.inline { display: flex; } .ad-edit .field { width: 100%; }
      .ad-title { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .1em; color: #8FE4FF; }
      .h3s { margin: 18px 0 4px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: .1em; text-transform: uppercase; color: #AEB8C7; }
      .cols3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 0 24px; }
      .rk { flex: none; width: 22px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 20px; }
      .mmain .grid > .card, .aside > .card { scroll-margin-top: calc(var(--bar-h, 64px) + 16px); }
      @media (max-width: 1180px) { .live-cols { grid-template-columns: minmax(0, 1fr); } .advent-wrap { grid-template-columns: minmax(0, 1fr); } }
      @media (max-width: 900px) {
        .mshell { grid-template-columns: minmax(0, 1fr); }
        .mnav { position: sticky; top: var(--bar-h, 104px); z-index: 20; flex-direction: row; gap: 6px; padding: 8px 12px; overflow-x: auto; border-right: 0; border-bottom: 1px solid #1C2230; scrollbar-width: none; }
        .ng { flex: none; border: 0; background: none; }
        .ng-items { display: none; }
        .ng-head { min-height: 40px; padding: 0 12px; border: 1px solid #2A3445; }
        .ng.on .ng-head { border-color: var(--ice); }
        .mbar { padding: 8px 12px; gap: 6px 10px; }
        .mbar .sep, .hd-n, .who-n { display: none; }
        .bar-clock { font-size: 24px; }
        .mmain { padding: 16px 12px 80px; }
        .mmain .grid > .card, .aside > .card { scroll-margin-top: calc(var(--bar-h, 104px) + 72px); }
      }
      code { padding: 0 6px; background: #0E1622; border: 1px solid #23415E; color: #8FE4FF; font-size: 0.92em; }
</style>
  </head>
  <body>
    <header class="mbar" id="bar"></header>
    <div class="mshell">
      <nav class="mnav" id="nav" aria-label="Secțiuni" hidden></nav>
      <main id="app" class="mmain" aria-live="polite"><p class="muted" style="margin-top: 20px">Se încarcă…</p></main>
    </div>
    <div class="msg" id="msg" role="status" hidden></div>
    <script>
      import '../scripts/mod';
    </script>
  </body>
</html>
