---
// Served by Cloudflare for any address that doesn't exist (wrangler.jsonc: not_found_handling = "404-page").
import '../styles/fonts.css';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Pagina nu există · ICEMARATON</title>
  </head>
  <body style="min-height: 100vh; display: grid; place-items: center; padding: 24px; color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; text-align: center">
    <main>
      <p style="margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 96px; line-height: 1; color: var(--ice)">404</p>
      <h1 style="margin: 8px 0 16px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 36px; text-transform: uppercase">Pagina nu există</h1>
      <a class="btn-primary" href={base} style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 24px; text-decoration: none; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 20px; text-transform: uppercase">Înapoi la ICEMARATON</a>
    </main>
  </body>
</html>
