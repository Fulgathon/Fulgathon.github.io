---
// OBS overlay: add as a Browser Source (1920×1080, transparent).
//   https://fulgathon.github.io/overlay/            timer + goal bar + new events
//   …/overlay/?show=timer                           only the timer
//   …/overlay/?show=timer,goal                      any combination of timer, goal, events
//   …/overlay/?demo                                  sample data, for testing the layout in OBS
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow-condensed/900-italic.css';
import '@fontsource/barlow/600.css';
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Overlay · FULGATHON</title>
    <style is:global>
      :root { --ice: #3FD0FF; }
      html, body { margin: 0; background: transparent; color: #F2F5FA; font-family: Barlow, sans-serif; }
      .box { position: fixed; left: 40px; bottom: 40px; width: 620px; padding: 18px 20px 20px; background: rgba(5, 6, 8, 0.86); border: 1px solid rgba(160, 225, 255, 0.35); }
      .label { display: flex; justify-content: space-between; align-items: center; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-style: italic; font-size: 22px; letter-spacing: .1em; text-transform: uppercase; color: #AEB8C7; }
      .badge { padding: 2px 10px; transform: skewX(-12deg); background: #2A3445; color: #fff; font-style: normal; font-size: 18px; letter-spacing: .08em; }
      .badge.live { background: #D5162B; }
      .clock { display: flex; align-items: center; gap: 8px; margin-top: 10px; }
      .tile { flex: 1 1 0; text-align: center; background: linear-gradient(180deg, #16304A 0%, #0C1A2A 50%, #08111C 50.5%, #0A1624 100%); border: 1px solid rgba(160, 225, 255, 0.35); padding: 6px 0 2px; }
      .digits { display: inline-block; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 92px; line-height: .95; font-variant-numeric: tabular-nums; background: linear-gradient(180deg, #FFFFFF 18%, #CDF2FF 58%, var(--ice) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .06em; }
      .unit { display: block; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: 15px; letter-spacing: .12em; text-transform: uppercase; color: #8C97A8; }
      .sep { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 60px; color: var(--ice); margin-top: -20px; }
      .goal { margin-top: 14px; }
      .goal-row { display: flex; justify-content: space-between; gap: 12px; font-size: 18px; font-weight: 600; color: #C9D2DF; }
      .bar { margin-top: 8px; height: 12px; background: #1A2230; }
      .fill { height: 100%; background: linear-gradient(90deg, #1E5BFF, var(--ice)); box-shadow: 0 0 18px rgba(63, 208, 255, .45); transition: width .6s ease; }
      .event { position: fixed; left: 40px; bottom: 300px; padding: 10px 18px; background: #050608; border: 3px solid var(--ice); font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-style: italic; font-size: 34px; opacity: 0; transform: translateY(20px); transition: opacity .4s, transform .4s; }
      .event.show { opacity: 1; transform: none; }
      .event b { color: var(--ice); }
      @media (prefers-reduced-motion: reduce) { .fill, .event { transition: none; } }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <div class="event" id="event" aria-live="polite"></div>
    <div class="box">
      <div id="timer-part">
        <div class="label"><span id="label">Timp rămas</span><span class="badge" id="badge">ÎNCEPE CURÂND</span></div>
        <div class="clock">
          <div class="tile"><span class="digits" id="dd">--</span><span class="unit">Zile</span></div><span class="sep">:</span>
          <div class="tile"><span class="digits" id="hh">--</span><span class="unit">Ore</span></div><span class="sep">:</span>
          <div class="tile"><span class="digits" id="mm">--</span><span class="unit">Minute</span></div><span class="sep">:</span>
          <div class="tile"><span class="digits" id="ss">--</span><span class="unit">Secunde</span></div>
        </div>
      </div>
      <div class="goal" id="goal-part">
        <div class="goal-row"><span>Urmează: <strong id="goal-title" style="color:#F2F5FA"></strong></span><span id="goal-progress"></span></div>
        <div class="bar"><div class="fill" id="goal-fill" style="width: 0%"></div></div>
      </div>
    </div>
    <script>
      import '../scripts/overlay';
    </script>
  </body>
</html>
