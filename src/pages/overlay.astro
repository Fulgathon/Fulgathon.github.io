      .ov-draw.won .dr-shards i { animation: drShard 1s ease-out both; }
      @keyframes drWin { 0% { transform: scale(1); } 35% { transform: scale(1.16); } 100% { transform: scale(1.1); } }
      @keyframes drBurst { 0% { opacity: .95; width: 10px; height: 10px; box-shadow: 0 0 30px 8px rgba(255,255,255,.45), inset 0 0 20px rgba(63,208,255,.5); } 100% { opacity: 0; width: 560px; height: 560px; box-shadow: 0 0 60px 20px rgba(255,255,255,0), inset 0 0 60px rgba(63,208,255,0); } }
      @keyframes drShard { 0% { opacity: 1; transform: rotate(var(--a)) translateY(-20px) scaleY(.4); } 100% { opacity: 0; transform: rotate(var(--a)) translateY(-210px) scaleY(1); } }
      body.frame .ov-draw { opacity: 1; min-height: 480px; }
      /* Pause scene (?scene=brb) */
      .ov-brb { position: fixed; inset: 0; background: #050608; }
      .brb-title { position: absolute; left: 80px; top: 80px; margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 140px; line-height: .9; text-transform: uppercase; }
      .brb-title span { color: var(--ice); }
      .brb-clock { position: absolute; left: 80px; top: 230px; margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 80px; color: #DFF6FF; font-variant-numeric: tabular-nums; }
      .brb-mascot { position: absolute; right: 80px; top: 60px; width: 520px; height: auto; filter: drop-shadow(0 20px 60px rgba(63,208,255,.25)); }
      .brb-panels { position: absolute; left: 80px; right: 80px; bottom: 80px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
      .brb-p { padding: 22px 26px; background: #0B1018; border: 1px solid #1C2230; }
      .brb-p.today { border: 2px solid var(--ice); }
      .brb-p .mk { margin: 0; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: .12em; color: #8C97A8; }
      .brb-p.today .mk { color: #8FE4FF; }
      .brb-p p:last-child { margin: 8px 0 0; font-size: 28px; line-height: 1.35; }
      /* ?part=…: one piece per OBS source, pinned to the source's top-left corner. */
      body.piece .ov-scene > [data-part]:not(.ov-moment) { left: 8px !important; top: 8px !important; right: auto !important; bottom: auto !important; }
      body.piece-promo .ov-promo { transform: none; margin: 0; }
      body.piece-moments .ov-moment { top: 8px; }
      body.piece-snow .ov-scene { display: none; }
      /* ?part=bubble (old name ?part=speech): only the speech bubble, bigger, its tail pointing down to his head on the camera. */
      body.piece-speech .ov-bubble { width: 324px; height: auto; }
      body.piece-speech .ov-bubble img { display: none; }
      body.piece-speech .ov-bubble .bub { position: relative; left: 0; top: 0; width: fit-content; max-width: 300px; margin: 6px 8px 22px; padding: 10px 14px; font-size: 26px; }
      body.piece-speech .ov-bubble .bub small { font-size: 13px; }
      body.piece-speech .ov-bubble .bub::after { right: auto; left: 26px; bottom: -16px; border-left: 0; border-bottom: 0; border-top: 18px solid #F2F5FA; border-right: 18px solid transparent; }
      body.piece-speech.tail-right .ov-bubble .bub { margin-left: auto; }
      body.piece-speech.tail-right .ov-bubble .bub::after { left: auto; right: 26px; border-right: 0; border-left: 18px solid transparent; }
      body.frame.piece-speech .ov-bubble { min-height: 90px; }
      /* ?frame=1: see where a piece sits while arranging the scene in OBS. */
      body.frame .ov-scene > [data-part] { outline: 2px dashed rgba(63, 208, 255, .85); outline-offset: 2px; opacity: 1 !important; }
      body.frame .ov-scene > [data-part]:empty::before { content: attr(data-part); display: block; padding: 10px 14px; font: 800 18px/1 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: #8FE4FF; }
      body.frame .ov-moment:not(.show) { min-height: 360px; }
      body.frame .ov-code:empty { width: 400px; min-height: 120px; }
      body.frame.piece-snow #ov-snow { outline: 2px dashed rgba(63, 208, 255, .85); outline-offset: -2px; }
      /* ?calm=1 and reduced motion: values just change, moments simply appear and go. */
      body.calm *, body.calm *::before, body.calm *::after { animation: none !important; transition: none !important; }
      @media (prefers-reduced-motion: reduce) { .ov-scene *, .ov-brb * { animation: none !important; transition: none !important; } }


      /* ---- «Camera de control» (?scene=control, src/scripts/scene-control.ts) ---------------- */
      body.scene-control { width: 1920px; height: 1080px; }
      .scc { position: absolute; left: 0; top: 0; width: 1920px; height: 1080px; transform-origin: 0 0; font-family: Barlow, sans-serif; color: #F2F5FA; }
      .scc[hidden] { display: none; }
      .scc-bg { position: absolute; inset: 0; }
      .scc-bg img { display: block; width: 1920px; height: 1080px; object-fit: cover; }
            .scc-hole { position: absolute; box-sizing: border-box; }
      .scc-hole::before, .scc-hole::after { content: ""; position: absolute; width: 26px; height: 26px; border: 4px solid var(--ice); }
      .scc-hole::before { left: -6px; top: -6px; border-right: 0; border-bottom: 0; }
      .scc-hole::after { right: -6px; bottom: -6px; border-left: 0; border-top: 0; }
      .scc-hole span { display: none; }
      body.frame .scc-hole { outline: 2px dashed rgba(63, 208, 255, .7); background: rgba(63, 208, 255, .08); }
      body.frame .scc-hole span { display: grid; place-items: center; height: 100%; font: italic 800 30px 'Barlow Condensed', sans-serif; letter-spacing: .08em; color: var(--ice); }
      .scc-panel { position: absolute; box-sizing: border-box; background: rgba(8, 18, 28, .84); border: 2px solid #1E4560; overflow: hidden; }
      .scc-lbl { margin: 0; font: italic 800 22px 'Barlow Condensed', sans-serif; letter-spacing: .12em; text-transform: uppercase; color: var(--ice); white-space: nowrap; }
      .scc-lbl.dim { color: #8FA3BC; }
      .scc-timer { display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 10px 24px 12px; }
      .scc-tline { display: flex; align-items: center; gap: 12px; margin: 0; }
      .scc-tag { padding: 2px 14px; background: #D5162B; color: #FFFFFF; font: italic 800 22px 'Barlow Condensed', sans-serif; letter-spacing: .08em; }
      .scc-tag[data-state="frozen"] { background: #9DB4C8; color: #06121C; }
      .scc-tag[data-state="double"] { background: #FF7A1A; color: #1A0A00; }
      .scc-tag[data-state="upcoming"], .scc-tag[data-state="ended"] { background: #2A3445; }
      .scc-tag[data-state="test"] { background: #F2C14E; color: #1A1300; }
      .scc-by { font: italic 800 22px 'Barlow Condensed', sans-serif; letter-spacing: .1em; text-transform: uppercase; color: #E6C46A; }
      .scc-clock { display: flex; align-items: flex-start; justify-content: space-between; }
      .scc-cg { display: flex; flex-direction: column; align-items: center; min-width: 96px; }
      .scc-cg b { font: italic 900 76px/0.95 'Barlow Condensed', sans-serif; color: #FFFFFF; font-variant-numeric: tabular-nums; letter-spacing: .01em; }
      .scc-cg span { margin-top: 2px; font: 700 15px Barlow, sans-serif; letter-spacing: .22em; color: #9DB0C6; }
      .scc-colon { font: italic 900 60px/1 'Barlow Condensed', sans-serif; color: var(--ice); opacity: .8; }
      .scc[data-state="frozen"] .scc-cg b { color: #B9CDDD; }
      .scc[data-state="double"] .scc-colon { color: #FF7A1A; }
      .scc-raised { display: flex; justify-content: space-between; align-items: baseline; margin: 0; padding-top: 8px; border-top: 1px solid #1E4560; }
      .scc-raised span { font: italic 800 22px 'Barlow Condensed', sans-serif; letter-spacing: .14em; text-transform: uppercase; color: #9DB0C6; }
      .scc-raised b { font: italic 800 32px 'Barlow Condensed', sans-serif; color: var(--ice); }
      .scc-tasks { display: flex; flex-direction: column; padding: 14px 22px; }
      .scc-menu { margin-top: 2px; }
      .scc-row { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 5px 0; border-bottom: 1px solid #13202C; font-size: 24px; }
      .scc-row span { font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; }
      .scc-row b { flex: none; font: italic 800 27px 'Barlow Condensed', sans-serif; color: var(--ice); }
      .scc-qhead { display: flex; justify-content: space-between; align-items: baseline; margin: 10px 0 0; }
      [data-pending].on { color: var(--ice); } [data-pending] { color: #F2F5FA; }
      .scc-queue { flex: 1; min-height: 0; overflow: hidden; }
      .scc-q { display: flex; align-items: center; gap: 12px; padding: 5px 12px; margin-top: 6px; background: #0B1A26; border-left: 4px solid var(--ice); font-size: 21px; line-height: 1.3; }
      .scc-q b { flex: none; font: italic 800 24px 'Barlow Condensed', sans-serif; color: var(--ice); }
      .scc-q span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0; } .scc-q i { font-style: normal; color: #8FA3BC; }
      .scc-q.new { animation: sccIn .7s cubic-bezier(.2,.8,.2,1) both; }
      @keyframes sccIn { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
      .scc-more { margin: 6px 0 0; font-size: 18px; color: #6B7A90; }
      /* Sponsor strip: frosted glass. Over the photo uploaded on /mod the blur is real (backdrop-filter);
         without one it is a light ice tint over whatever OBS shows below. */
      .scc-spon { display: flex; align-items: center; gap: 28px; padding: 16px 22px;
        background: rgba(190, 220, 245, .035); border: 1px solid rgba(220, 240, 255, .13);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, .10), 0 8px 30px rgba(0, 0, 0, .22);
        -webkit-backdrop-filter: blur(22px) saturate(1.05) brightness(.72); backdrop-filter: blur(22px) saturate(1.05) brightness(.72); }
      .scc-spon .scc-logo { background: rgba(4, 8, 14, .38); border-color: rgba(220, 240, 255, .10); }
      .scc-spon .scc-logo span { color: #C9D6E6; }
      .scc-logo { box-sizing: border-box; height: 100%; display: grid; place-items: center; border: 2px solid #2A2A22; background: rgba(10, 12, 14, .85); overflow: hidden; padding: 10px 14px; transition: border-color .8s; }
      .scc-logo img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
      .scc-logo span { max-width: 100%; text-align: center; line-height: 1.15; color: #8A8470; font-size: 24px; }
      .scc-logo.main { flex: 0 0 300px; } .scc-logo.main span { font: italic 800 56px 'Barlow Condensed', sans-serif; color: #F2F5FA; }
      .scc-logo.main.lit { border-color: #E6C46A; }
      .scc-car { position: relative; overflow: hidden; height: 100%; } .scc-car.p { flex: 1; } .scc-car.s { flex: 0 0 300px; height: 80%; }
      .scc-car.s .scc-logo span { font-size: 20px; }
      .scc-pg { position: absolute; inset: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .scc-snow { position: absolute; inset: 0; pointer-events: none; }
      .scc-toast { position: absolute; padding: 2px 14px; background: #0B1018; border: 2px solid var(--ice); font-size: 18px; line-height: 1.25; white-space: nowrap; opacity: 0; transform: translateY(10px); transition: opacity .4s, transform .4s; pointer-events: none; }
      .scc-toast.show { opacity: 1; transform: none; }
      .scc-warm { position: absolute; inset: 0; pointer-events: none; background: #FF7A1A; opacity: 0; transition: opacity 1s; mix-blend-mode: screen; } .scc-warm.on { opacity: .1; }
      .scc-frost { position: absolute; inset: 0; pointer-events: none; transition: box-shadow 1.2s; } .scc-frost.on { box-shadow: inset 0 0 140px 40px rgba(200, 240, 255, .4); }
      body.calm .scc-toast, body.calm .scc-warm, body.calm .scc-frost { transition: none; }
      body.calm .scc-q.new { animation: none; }
      @media (prefers-reduced-motion: reduce) { .scc-q.new { animation: none; } .scc-toast { transition: none; } }
    </style>
  </head>
  <body class="pos-tr">
    <!-- Slim strip -->
    <div class="scc" id="control" hidden></div>
    <div class="compact" id="compact">
      <div class="strip" id="strip">
        <div class="strip-row" data-part="timer">
          <span class="brand"><b>ICE</b>MARATON</span>
          <span class="clock digits-ice" data-clock>--:--:--:--</span>
          <span class="badge" data-badge>ÎNCEPE CURÂND</span>
        </div>
        <div class="goal-line" data-part="goal">
          <div class="bar"><div class="fill" data-fill></div></div>
          <span data-progress></span>
        </div>
        <div class="double-line" data-double hidden></div>
      </div>
      <div class="chip" data-event aria-live="polite"></div>
      <div class="code-chip" data-code aria-live="polite"></div>
    </div>

    <!-- Large box (?style=box) -->
    <div class="box-event" data-event aria-live="polite" hidden></div>
    <div class="box" id="box" hidden>
      <div data-part="timer">
        <div class="label"><span data-label>Timp rămas</span><span class="badge" data-badge>ÎNCEPE CURÂND</span></div>
        <div class="clockrow">
          <div class="tile"><span class="digits-ice" data-unit="dd">--</span><span class="unit">Zile</span></div><span class="sep">:</span>
          <div class="tile"><span class="digits-ice" data-unit="hh">--</span><span class="unit">Ore</span></div><span class="sep">:</span>
          <div class="tile"><span class="digits-ice" data-unit="mm">--</span><span class="unit">Minute</span></div><span class="sep">:</span>
          <div class="tile"><span class="digits-ice" data-unit="ss">--</span><span class="unit">Secunde</span></div>
        </div>
      </div>
      <div class="goal" data-part="goal">
        <div class="goal-row"><span>Urmează: <strong data-goal-title style="color:#F2F5FA"></strong></span><span data-progress></span></div>
        <div class="bar"><div class="fill" data-fill></div></div>
      </div>
    </div>
    <canvas id="ov-snow" aria-hidden="true"></canvas>
    <span id="ov-assets" hidden data-emote={emoteImg.src}></span>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute"><defs><linearGradient id="ovPrism" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#9FE8FF"></stop><stop offset="0.3" stop-color="#A9B8FF"></stop><stop offset="0.52" stop-color="#E2B6FF"></stop><stop offset="0.74" stop-color="#FFD6C2"></stop><stop offset="1" stop-color="#C8FFE9"></stop></linearGradient></defs></svg>

    <!-- Scene (layout v2, default) -->
    <div class="ov-scene" id="scene" hidden>
      <div class="ov-together panel" data-part="together">
        <div><p class="tg-k">ORE ÎMPREUNĂ</p><p class="tg-v"><span data-hours>0</span> <small data-hof></small></p></div>
        <div><p class="tg-k">ADĂUGAT AZI</p><p class="tg-v" data-today>+0 min</p></div>
      </div>
      <div class="ov-bubble" data-part="bubble" aria-live="polite">
        <img src={mascot.src} alt="" width="200" height="194" />
        <div class="bub"><small data-bwho></small><span data-btext></span></div>
      </div>
      <div class="ov-vote panel" data-part="vote">
        <p class="v-head"><span data-vround></span><b data-vleft></b></p>
        <div data-vlist></div>
        <p class="v-foot">Votează pe site · doar abonații</p>
      </div>
      <div class="ov-moment" data-part="moments" aria-live="polite"></div>
      <div class="ov-code" data-part="code" aria-live="polite"></div>
      <div class="ov-draw" data-part="draw" aria-live="polite"></div>
      <div class="ov-timer" data-part="timer" data-state="live">
        <div class="tm-frost" aria-hidden="true"><div class="tm-crystals"></div><div class="tm-shine"></div><svg class="tm-ice" viewBox="0 0 400 18" preserveAspectRatio="none"><defs><linearGradient id="tmIce" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#FFFFFF" stop-opacity=".95"/><stop offset="1" stop-color="#BFE9FF" stop-opacity=".15"/></linearGradient></defs><path fill="url(#tmIce)" d="M0 0H400V2L392 2 388 9 384 2 370 2 367 14 363 2 344 2 341 7 338 2 318 2 314 16 310 2 292 2 289 8 286 2 262 2 258 12 254 2 236 2 233 6 230 2 206 2 202 15 198 2 178 2 175 8 172 2 150 2 146 11 142 2 120 2 117 6 114 2 94 2 90 17 86 2 66 2 63 9 60 2 40 2 37 13 33 2 16 2 13 7 10 2 0 2Z"/></svg><i></i><i></i><i></i><i></i><i></i></div>
        <div class="tm-fire" aria-hidden="true"><div class="tm-heat"></div><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl"></span><span class="fl c"></span><span class="fl c"></span><span class="fl c"></span><span class="fl c"></span><span class="fl c"></span><div class="tm-bed"></div><i></i><i></i><i></i><i></i></div>
        <div class="tm-top">
          <span class="tm-brand"><b>ICE</b>MARATON</span>
          <span class="tm-tag" data-ttag><span class="tm-dot"></span><span class="tm-fi"><svg class="tm-fire-ic" width="12" height="14" viewBox="0 0 24 28" fill="currentColor" aria-hidden="true"><path d="M12 0c1 6 8 9 8 17a8 8 0 0 1-16 0c0-4 2-6 4-8 0 3 1 5 3 6-1-6 1-11 1-15z"/></svg></span><span class="tm-fl"><svg class="tm-flake" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="square" aria-hidden="true"><path d="M12 2v20M3.3 7l17.4 10M3.3 17L20.7 7M9 4l3 3 3-3M9 20l3-3 3 3"/></svg></span><span data-ttext>LIVE</span></span>
        </div>
        <div class="tm-digits" role="timer" aria-live="off">
          <div class="tm-u"><span class="tm-n" data-u="dd"></span><span class="tm-l">ZILE</span></div><span class="tm-sep"></span>
          <div class="tm-u"><span class="tm-n" data-u="hh"></span><span class="tm-l">ORE</span></div><span class="tm-sep"></span>
          <div class="tm-u"><span class="tm-n" data-u="mm"></span><span class="tm-l">MIN</span></div><span class="tm-sep"></span>
          <div class="tm-u"><span class="tm-n" data-u="ss"></span><span class="tm-l">SEC</span></div>
        </div>
        <div class="tm-sweep"><i data-sweep></i></div>
        <div class="tm-url"><span class="tm-site">icemanlucky<b>.ro</b></span><span class="tm-tick" data-tick></span></div>
        <div class="tm-gain" data-gain aria-hidden="true"><span class="tg-l" data-gainl>TIMP ADĂUGAT</span><span class="tg-v" data-gainv></span></div>
      </div>
      <div class="ov-mile panel" data-part="goal">
        <p class="m-head"><span data-mtag>URMĂTORUL MILESTONE</span><b data-mleft></b></p>
        <p class="m-title" data-mtitle></p>
        <div class="bar"><span data-mbar style="width:0"></span></div>
        <p class="m-of" data-mof></p>
      </div>
      <p class="ov-promo" data-part="promo">Cu sprijinul <strong></strong><span data-pline></span></p>
    </div>

    <!-- Pause scene (?scene=brb) -->
    <div class="ov-brb" id="brb" hidden>
      <p class="brb-title">Revin <span>imediat</span></p>
      <p class="brb-clock" data-bclock>--:--:--:--</p>
      <img class="brb-mascot" src={mascot.src} alt="" width="520" height="505" />
      <div class="brb-panels" data-bpanels></div>
    </div>
    <script>
      // The old strip and box (?style=strip, ?style=box) keep their own script; the scene is the default.
      const style = new URLSearchParams(location.search).get('style');
      if (style === 'box' || style === 'strip') void import('../scripts/overlay-classic');
      else if (new URLSearchParams(location.search).get('scene') === 'control') void import('../scripts/scene-control');
      else void import('../scripts/overlay-scene');
    </script>
  </body>
</html>
