---
// Sponsor presentation: what a brand gets, shown live on the real site and
// stream overlay with the visitor's own brand name. Runs on its own copy of
// the demo backend (?demo=pitch); nothing here touches the real database.
import '../styles/fonts.css';
import '../styles/global.css';
import StreamBlueprint from '../components/StreamBlueprint.astro';
import { getImage } from 'astro:assets';
import emote from '../../assets/emote.png';
const favicon = await getImage({ src: emote, format: 'png', width: 64 });
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pentru parteneri · ICEMARATON</title>
    <link rel="icon" type="image/png" href={favicon.src} />
    <style is:global>
      html, body { height: 100%; }
      body { color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; font-size: 16px; line-height: 1.5; overflow: hidden; }
      .shell { height: 100vh; display: grid; grid-template-rows: auto minmax(0, 1fr); grid-template-columns: minmax(0, 1fr); }
      .bar, .main, .sim { min-width: 0; }
      .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; padding: 10px 20px; border-bottom: 1px solid #1A2230; background: #0B1018; }
      .brand { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 28px; line-height: 1; text-transform: uppercase; white-space: nowrap; }
      .brand .ice { background: linear-gradient(180deg, #FFFFFF 18%, #CDF2FF 58%, var(--ice) 100%); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .04em; }
      .brand .sub { color: #8C97A8; font-size: 20px; font-weight: 800; margin-left: 8px; }
      .readout { display: flex; align-items: center; gap: 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 18px; white-space: nowrap; }
      .readout .clock { font-weight: 900; font-style: italic; font-size: 24px; font-variant-numeric: tabular-nums; color: var(--ice); }
      .readout .badge { padding: 1px 8px; transform: skewX(-12deg); background: #2A3445; font-size: 13px; letter-spacing: .08em; }
      .readout .badge.live { background: #D5162B; }
      .sim { margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
      .sim > span { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: #B794FF; margin-right: 4px; }
      .sim button, .act { min-height: 40px; padding: 0 12px; background: transparent; color: #F2F5FA; border: 2px solid #2A3445; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 15px; text-transform: uppercase; letter-spacing: .03em; cursor: pointer; }
      .sim button:hover, .act:hover { border-color: var(--ice); }
      .sim button.twitch { border-color: #9146FF; }
      .sim button[aria-pressed="true"] { background: var(--ice); border-color: var(--ice); color: #04101A; }
      .main { display: grid; grid-template-columns: minmax(320px, 400px) 1fr; min-height: 0; }
      .steps { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid #1A2230; background: #090C11; }
      .toc { list-style: none; margin: 0; padding: 10px 10px 0; display: flex; flex-wrap: wrap; gap: 4px; }
      .toc button { min-width: 36px; min-height: 36px; padding: 0 8px; background: transparent; color: #8C97A8; border: 1px solid #1A2230; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 15px; cursor: pointer; }
      .toc button[aria-current="step"] { background: var(--ice); border-color: var(--ice); color: #04101A; }
      .step { flex: 1 1 auto; overflow-y: auto; padding: 18px 22px 24px; }
      .step .num { display: inline-block; transform: skewX(-12deg); background: var(--ice); color: #04101A; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 15px; padding: 2px 10px; letter-spacing: .06em; }
      .step h1 { margin: 10px 0 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 40px; line-height: .95; text-transform: uppercase; }
      .step p { margin: 0 0 12px; color: #C9D2DF; }
      .step p strong { color: #F2F5FA; }
      .step ul { margin: 0 0 12px; padding-left: 18px; color: #C9D2DF; }
      .step .try { margin-top: 18px; padding-top: 14px; border-top: 1px dashed #2A3445; }
      .step .try-label { margin: 0 0 8px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: var(--ice); }
      .acts { display: flex; flex-wrap: wrap; gap: 8px; }
      .act.primary { background: var(--ice); border-color: var(--ice); color: #04101A; }
      .nav { display: flex; gap: 8px; padding: 12px 22px; border-top: 1px solid #1A2230; }
      .nav button { flex: 1 1 0; min-height: 48px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 20px; text-transform: uppercase; cursor: pointer; }
      .stage { position: relative; min-height: 0; overflow: hidden; background: radial-gradient(ellipse at 50% 30%, rgba(63,208,255,.06), transparent 60%), #050608; }
      .view { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; gap: 18px; padding: 22px; }
      .view[hidden] { display: none !important; }
      .slot { position: relative; flex: 1 1 0; height: 100%; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
      .slot-label { margin: 0 0 8px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: #8C97A8; }
      .fit { position: relative; flex: 1 1 auto; width: 100%; min-height: 0; }
      .frame { position: absolute; top: 0; left: 0; overflow: hidden; border: 1px solid #2A3445; box-shadow: 0 24px 60px rgba(0,0,0,.6); background: #050608; }
      .frame iframe, .frame .scene { position: absolute; top: 0; left: 0; border: 0; transform-origin: top left; background: transparent; }
      .frame.phone { box-sizing: content-box; border: 10px solid #1A2230; border-radius: 34px; }
      .scene { overflow: hidden; background: #24332A; }
      .scene img { position: absolute; right: 0; bottom: 0; height: 100%; width: auto; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 25%); mask-image: linear-gradient(90deg, transparent 0, #000 25%); }
      .scene .hint { position: absolute; left: 60px; top: 50%; transform: translateY(-50%); max-width: 640px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 64px; line-height: 1; text-transform: uppercase; color: rgba(242,245,250,.14); }
      .final { max-width: 980px; width: 100%; max-height: 100%; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; align-content: center; }
      .card { padding: 20px; background: #0B1018; border: 1px solid #1A2230; }
      .card h2 { margin: 0 0 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 26px; text-transform: uppercase; }
      .card ol, .card ul { margin: 0; padding-left: 20px; color: #C9D2DF; }
      .card li { margin: 6px 0; }
      .card.ice { border-color: var(--ice); }
      .links { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 8px; }
      .links a { min-height: 44px; display: inline-flex; align-items: center; padding: 0 14px; border: 2px solid #2A3445; color: #F2F5FA; text-decoration: none; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; text-transform: uppercase; }
      .links a:hover { border-color: var(--ice); }
      .brandin { margin-left: auto; display: flex; align-items: center; gap: 10px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: var(--ice); }
      .brandin input { min-height: 44px; width: min(260px, 50vw); padding: 0 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: .02em; text-transform: none; }
      .metrics { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
      .metric { padding: 16px; background: #0B1018; border: 1px solid #1A2230; }
      .metric b { display: block; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 40px; line-height: 1; color: var(--ice); }
      .metric span { display: block; margin-top: 6px; font-size: 14px; color: #AEB8C7; }
      .pkg { display: flex; flex-direction: column; }
      .pkg .seats { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 14px; letter-spacing: .1em; text-transform: uppercase; color: #8C97A8; }
      .pkg .price { margin-top: auto; padding-top: 14px; font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 24px; }
      .card .tag { display: inline-block; padding: 1px 8px; transform: skewX(-12deg); background: var(--ice); color: #04101A; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; letter-spacing: .08em; }
      .view[data-view="report"], .view[data-view="packages"] { align-items: flex-start; }
      #report, #packages { align-content: start; }
      /* Line-art plan of the stream (StreamBlueprint + scripts/blueprint.ts). Three line weights: 1.1 / 1.8 / 2.6. */
      .frame iframe[data-overlay-src] { pointer-events: none; }
      .bp text { font-family: Barlow, sans-serif; font-weight: 600; font-size: 14px; letter-spacing: .14em; fill: #8C97A8; stroke: none; }
      .bp .lbl.ice { fill: #3FD0FF; fill-opacity: .75; }
      .bp .solid { fill: #05090F; }
      .bp .fine { stroke-width: 1.1; stroke-opacity: .6; fill: none; }
      .bp .game { stroke: #3FD0FF; stroke-width: 1.8; }
      .bp .bank { stroke-opacity: .55; }
      .bp .rock { stroke-opacity: .4; stroke-width: 1.2; fill: #05090F; }
      .bp .reed { stroke-opacity: .35; stroke-width: 1.1; }
      .bp .ripple { stroke-opacity: .3; stroke-width: 1.1; stroke-dasharray: 10 8; animation: bp-flow 4s linear infinite; }
      .bp .edge { stroke-opacity: .5; }
      .bp .curb { stroke-opacity: .32; stroke-width: 1.1; fill: #05090F; }
      .bp .pave { stroke-opacity: .13; stroke-width: 1.1; }
      .bp .crack { stroke-opacity: .2; stroke-width: 1; }
      .bp .wall .plateau { fill: #05090F; stroke-opacity: .6; }
      .bp .wall .cliff-base { stroke-opacity: .35; stroke-width: 1.2; }
      .bp .wall .hatch { stroke-opacity: .3; stroke-width: 1.1; }
      .bp .wall .rim { stroke-opacity: .2; stroke-width: 1.1; }
      .bp .wall .tuft { stroke-opacity: .28; stroke-width: 1.1; }
      .bp .brush path { stroke-opacity: .45; stroke-width: 1.2; }
      .bp .brush .brush-ground { stroke-opacity: .25; }
      .bp .shadow { fill: #3FD0FF; fill-opacity: .06; stroke: none; }
      .bp .hpf { fill: #05090F; stroke-width: 1.1; }
      .bp .hpv { fill: #C9D2DF; fill-opacity: .5; stroke: none; }
      .bp .hpv.ice { fill: #3FD0FF; fill-opacity: .75; }
      .bp .tick { stroke: #05090F; stroke-opacity: 1; stroke-width: 1.2; }
      .bp .mana { fill: #3FD0FF; fill-opacity: .32; stroke: none; transition: width .4s ease; }
      .bp .tower { stroke: #C9D2DF; stroke-opacity: .6; }
      .bp .tower .range { fill: none; stroke-opacity: .16; stroke-dasharray: 6 10; animation: bp-flow 16s linear infinite; }
      .bp .tower .shadow { fill: #C9D2DF; fill-opacity: .04; }
      .bp .tower .halo { fill: none; stroke-opacity: .35; animation: bp-glint 2.4s ease-in-out infinite alternate; }
      .bp .tower .crystal { animation: bp-bob 2.4s ease-in-out infinite alternate; }
      .bp .wave .hpv { fill: #3FD0FF; fill-opacity: .6; }
      .bp .wave.enemy { stroke: #C9D2DF; stroke-opacity: .7; }
      .bp .wave.enemy .hpv { fill: #C9D2DF; }
      .bp .wave .orb { fill: #3FD0FF; fill-opacity: .2; }
      .bp .wave [data-i] { transition: opacity .35s ease; }
      .bp .wave .killed { opacity: 0; }
      .bp .champ .ring { stroke-opacity: .85; stroke-width: 2.2; }
      .bp .champ .ring2 { stroke-opacity: .4; stroke-width: 1.1; stroke-dasharray: 6 5; animation: bp-flow 5s linear infinite; }
      .bp .champ .specks { stroke-width: 1.1; stroke-opacity: .7; animation: bp-rise 3.2s ease-in-out infinite; }
      .bp .champ .eye, .bp .eye { fill: #3FD0FF; stroke: none; }
      .bp .champ .staff { stroke-width: 2.6; }
      .bp .gem { fill: #3FD0FF; fill-opacity: .22; stroke-width: 1.4; }
      .bp .champ .orbit { transform-box: fill-box; transform-origin: center; animation: bp-spin 6s linear infinite; }
      .bp .champ.cast .gem { fill-opacity: .8; }
      .bp .tag { font-size: 13px; fill: #DDE4EE; }
      .bp .lvl { font-size: 12px; letter-spacing: 0; fill: #C9D2DF; }
      .bp .hud { fill: none; stroke: #3FD0FF; stroke-opacity: .55; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
      .bp .hud .panel { fill: #070C14; stroke: #C9D2DF; stroke-opacity: .4; }
      .bp .hud .inner { fill: none; stroke: #C9D2DF; stroke-opacity: .14; stroke-width: 1.1; }
      .bp .hud .sep { stroke: #C9D2DF; stroke-opacity: .18; stroke-width: 1.1; }
      .bp .hud .keys { stroke-opacity: .6; }
      .bp .hud .glyph { stroke-opacity: .85; stroke-width: 1.6; }
      .bp .hud .xp { stroke-width: 2.6; stroke-opacity: .7; }
      .bp .hud .pip { fill: none; stroke-width: 1.1; stroke-opacity: .45; }
      .bp .hud .pip.on { fill: #3FD0FF; fill-opacity: .8; stroke: none; }
      .bp .hud .coin { stroke: #C9D2DF; stroke-opacity: .7; }
      .bp .num { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: .03em; fill: #C9D2DF; font-variant-numeric: tabular-nums; }
      .bp .num.ice { fill: #3FD0FF; }
      .bp .num.sm { font-size: 17px; }
      .bp .key { font-size: 11px; letter-spacing: 0; fill: #AEB8C7; }
      .bp .bartxt { font-size: 11px; letter-spacing: .06em; fill: #05090F; font-weight: 700; }
      .bp .cd { fill: #05090F; fill-opacity: .7; stroke: none; transform-box: fill-box; transform-origin: bottom; transform: scaleY(0); }
      .bp .cd.on { transform: scaleY(1); }
      .bp .cd.run { transition: transform 3.5s linear; transform: scaleY(0); }
      .bp .map .mwall { fill: #3FD0FF; fill-opacity: .05; stroke-opacity: .28; stroke-width: 1.1; }
      .bp .map .lanes { stroke: #C9D2DF; stroke-opacity: .35; stroke-width: 2.6; }
      .bp .map .river-s { stroke-opacity: .4; stroke-width: 1.1; }
      .bp .map .pit { stroke-opacity: .35; stroke-width: 1.1; stroke-dasharray: 3 3; }
      .bp .map .base { stroke-opacity: .5; }
      .bp .map .nexus { fill: #3FD0FF; fill-opacity: .25; }
      .bp .map .nexus.e, .bp .map .tw.e { stroke: #C9D2DF; fill: #C9D2DF; fill-opacity: .2; }
      .bp .map .tw { fill: #3FD0FF; fill-opacity: .25; stroke-width: 1.1; }
      .bp .map .view { stroke: #F2F5FA; stroke-opacity: .75; stroke-width: 1.4; }
      .bp .champ-i { animation: bp-drift 6s ease-in-out infinite alternate; }
      .bp .champ-i circle { fill: #05090F; stroke-width: 1.8; }
      .bp .champ-i .core { fill: #3FD0FF; stroke: none; }
      .bp .champ-i.e circle { stroke: #C9D2DF; stroke-opacity: .7; }
      .bp .champ-i.e .core { fill: #C9D2DF; }
      .bp .champ-i.me circle { stroke: #F2F5FA; stroke-opacity: 1; stroke-width: 2.2; }
      .bp .champ-i.me .core { fill: #F2F5FA; }
      .bp .cam { fill: none; stroke: #3FD0FF; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
      .bp .camframe { fill: #070C14; stroke-opacity: .7; }
      .bp .caminner { stroke-opacity: .16; stroke-width: 1.1; }
      .bp .led { stroke-opacity: .45; stroke-width: 3; animation: bp-led 6s ease-in-out infinite alternate; }
      .bp .hex path { stroke-opacity: .22; stroke-width: 1.4; }
      .bp .hex .glow { stroke-opacity: .6; fill: #3FD0FF; fill-opacity: .05; animation: bp-glint 3.5s ease-in-out infinite alternate; }
      .bp .chair { stroke-opacity: .3; stroke-width: 1.6; }
      .bp .who { animation: bp-breathe 3.6s ease-in-out infinite alternate; }
      .bp .head { transform-box: fill-box; transform-origin: 50% 100%; animation: bp-tilt 11s ease-in-out infinite; }
      .bp .beard { fill: #3FD0FF; fill-opacity: .8; stroke-width: 1; }
      .bp .beard.soft { fill-opacity: .4; }
      .bp .stubble { stroke-width: 2; stroke-opacity: .45; }
      .bp .dashed { stroke-dasharray: 2 4; }
      .bp .lid { stroke-width: 1.6; }
      .bp .eyes { transform-box: fill-box; transform-origin: center; animation: bp-blink 5s infinite; }
      .bp .eyes ellipse { stroke-width: 1.4; fill: #05090F; }
      .bp .pupil { fill: #3FD0FF; stroke: none; }
      .bp .band { stroke-width: 4; }
      .bp .ledot { fill: #3FD0FF; stroke: none; animation: bp-glint 1.4s ease-in-out infinite alternate; }
      .bp .aglet { stroke-width: 3.4; }
      .bp .lbl-cam { font-size: 13px; }
      .bp .joy, .bp .buzz, .bp .talk { display: none; }
      .bp .cam.talking .mouth { display: none; }
      .bp .cam.talking .talk { display: inline; transform-box: fill-box; transform-origin: center; animation: bp-talk .32s ease-in-out infinite alternate; }
      .bp .cam.hype .who { animation: bp-jump .7s ease-out 2; }
      .bp .cam.hype .eyes, .bp .cam.hype .mouth, .bp .cam.hype .talk { display: none; }
      .bp .cam.hype .joy, .bp .cam.hype .buzz { display: inline; }
      .bp .bubble { opacity: 0; }
      .bp .bubble rect, .bp .bubble path { fill: #05090F; stroke: #3FD0FF; stroke-width: 2.5; stroke-linejoin: round; }
      .bp .bubble text { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 34px; letter-spacing: .02em; fill: #F2F5FA; }
      .bp .bubble.show { opacity: 1; }
      .bp .bubble.show > * { animation: bp-pop .28s ease-out; }
      .bp .fx { pointer-events: none; }
      .bp .shot { stroke: #3FD0FF; stroke-width: 4; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; animation: bp-shot .55s ease-out forwards; }
      .bp .shot.trail { stroke-width: 1.2; stroke-opacity: .6; animation-delay: .04s; }
      .bp .boom { fill: none; stroke: #3FD0FF; stroke-width: 2.2; transform-box: fill-box; transform-origin: center; animation: bp-boom .6s .22s ease-out both; }
      .bp .shard { stroke: #3FD0FF; stroke-width: 1.4; animation: bp-burst .6s .22s ease-out both; }
      .bp .gold { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-style: italic; font-size: 26px; fill: #F2F5FA; paint-order: stroke; stroke: #05090F; stroke-width: 6px; animation: bp-float 1.3s .25s ease-out both; }
      .bp .ping { fill: none; stroke: #F2F5FA; stroke-width: 2.2; transform-box: fill-box; transform-origin: center; animation: bp-boom 1.1s ease-out both; }
      .bp .ping.second { animation-delay: .3s; }
      .bp .ping-mark { fill: #F2F5FA; stroke: none; animation: bp-fadeout 1.6s ease-in both; }
      /* Callouts */
      .bp .focus { display: none; }
      .scene[data-focus="double"] .focus[data-k="double"], .scene[data-focus="code"] .focus[data-k="code"],
      .scene[data-focus="promo"] .focus[data-k="promo"], .scene[data-focus="wins"] .focus[data-k="wins"] { display: inline; }
      .bp .focus .box { fill: none; stroke: #3FD0FF; stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: 1; animation: bp-draw .9s ease forwards; }
      .bp .focus .lead { fill: none; stroke: #3FD0FF; stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 1; animation: bp-draw .5s .7s ease forwards; }
      .bp .focus text { paint-order: stroke; stroke: #05090F; stroke-width: 10px; stroke-linejoin: round; opacity: 0; animation: bp-fade .4s 1s ease forwards; }
      .bp .focus .cap { fill: #AEB8C7; font-size: 16px; }
      .bp .focus .brand { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 32px; letter-spacing: .06em; fill: #F2F5FA; }
      @keyframes bp-draw { to { stroke-dashoffset: 0; } }
      @keyframes bp-fade { from { opacity: 0; } to { opacity: 1; } }
      @keyframes bp-fadeout { 0%, 60% { opacity: 1; } 100% { opacity: 0; } }
      @keyframes bp-flow { to { stroke-dashoffset: -72; } }
      @keyframes bp-bob { to { transform: translateY(-8px); } }
      @keyframes bp-spin { to { transform: rotate(360deg); } }
      @keyframes bp-rise { 0% { transform: translateY(4px); opacity: 0; } 30%, 70% { opacity: .9; } 100% { transform: translateY(-14px); opacity: 0; } }
      @keyframes bp-glint { from { opacity: .45; } to { opacity: 1; } }
      @keyframes bp-led { from { stroke-opacity: .25; } to { stroke-opacity: .6; } }
      @keyframes bp-drift { to { transform: translate(4px, -3px); } }
      @keyframes bp-breathe { to { transform: translateY(-3px); } }
      @keyframes bp-tilt { 0%, 38%, 56%, 100% { transform: rotate(0); } 44%, 50% { transform: rotate(-2.5deg); } }
      @keyframes bp-blink { 0%, 94%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
      @keyframes bp-talk { from { transform: scaleY(.35); } to { transform: scaleY(1); } }
      @keyframes bp-jump { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-16px); } }
      @keyframes bp-pop { from { transform: translateY(14px); opacity: 0; } to { transform: none; opacity: 1; } }
      @keyframes bp-shot { 0% { stroke-dashoffset: 1; opacity: 1; } 55% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
      @keyframes bp-boom { from { transform: scale(.2); opacity: 1; } to { transform: scale(1.6); opacity: 0; } }
      @keyframes bp-burst { from { stroke-dashoffset: 0; opacity: 1; } to { opacity: 0; } }
      @keyframes bp-float { from { transform: translateY(0); opacity: 1; } to { transform: translateY(-46px); opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        .bp *, .bp { animation: none !important; transition: none !important; }
        .bp .focus .box, .bp .focus .lead { stroke-dashoffset: 0; }
        .bp .focus text { opacity: 1; }
      }
      .split-tabs { display: none; }
      /* Phones and tablets: the live pages render at their real size (the
         script switches the frames), the demo sits on top, the step below,
         and the Twitch buttons scroll sideways. */
      @media (max-width: 1000px) {
        .shell { height: 100vh; height: 100dvh; }
        .bar { padding: 8px 12px 0; gap: 6px 12px; }
        .brand { font-size: 22px; }
        .brand .sub { display: none; }
        .brandin { flex: 1 0 100%; margin: 0 0 8px; font-size: 12px; }
        .brandin input { flex: 1 1 auto; width: auto; }
        .sim { flex: 1 0 100%; margin: 0 -12px; padding: 0 12px 8px; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
        .sim::-webkit-scrollbar { display: none; }
        .sim > span { flex: none; font-size: 12px; }
        .sim button { flex: none; min-height: 44px; padding: 0 10px; font-size: 14px; }
        .main { display: flex; flex-direction: column; }
        .stage { order: -1; flex: 0 0 52%; border-bottom: 1px solid #1A2230; }
        .steps { flex: 1 1 0; border-right: 0; }
        .toc { display: none; }
        .step { padding: 12px 16px 16px; }
        .step h1 { margin: 8px 0 10px; font-size: 30px; }
        .step p, .step ul { font-size: 15px; }
        .act { min-height: 44px; }
        .nav { padding: 8px 12px; padding-bottom: max(8px, env(safe-area-inset-bottom)); }
        .nav button { min-height: 44px; font-size: 18px; }
        .view { padding: 0; gap: 0; }
        .frame { border: 0; box-shadow: none; }
        .frame.phone { border: 0; border-radius: 0; }
        .view[data-view="split"] { flex-direction: column; align-items: stretch; }
        .split-tabs { display: flex; flex: none; width: 100%; }
        .split-tabs button { flex: 1 1 0; min-height: 44px; background: #0B1018; color: #8C97A8; border: 0; border-bottom: 2px solid #1A2230; font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 15px; letter-spacing: .06em; text-transform: uppercase; cursor: pointer; }
        .split-tabs button[aria-pressed="true"] { color: #F2F5FA; border-bottom-color: var(--ice); }
        .view[data-view="split"] .slot-label { display: none; }
        .view[data-show="mod"] [data-slot="site2"], .view[data-show="site2"] [data-slot="mod"] { display: none; }
        .view[data-view="overlay"] .slot { padding: 10px; }
        .slot-label { font-size: 12px; text-align: center; }
        .final { padding: 12px; gap: 12px; align-content: start; }
        .card { padding: 16px; }
      }
      /* Phone upright: the 16:9 stream plan only needs its own height, the rest goes to the text. */
      @media (max-width: 1000px) and (orientation: portrait) {
        .stage:has(> .view[data-view="stream"]:not([hidden])) { flex: 0 0 auto; height: calc(56.25vw + 32px); }
      }
      /* Phone or tablet held sideways: steps left, demo right, one header row. */
      @media (max-width: 1000px) and (orientation: landscape) {
        .bar { flex-wrap: nowrap; padding-bottom: 6px; }
        .readout { margin-left: 0; }
        .sim { flex: 1 1 0; min-width: 0; margin: 0; padding: 0; }
        .main { display: grid; grid-template-columns: minmax(260px, 36%) 1fr; }
        .stage { order: 0; border-bottom: 0; }
        .steps { border-right: 1px solid #1A2230; }
        .step h1 { font-size: 26px; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="bar">
        <div class="brand"><span class="ice">Ice</span>maraton<span class="sub">· pentru parteneri</span></div>
        <label class="brandin">Brandul vostru
          <input id="brand" class="field" maxlength="40" autocomplete="organization" placeholder="ex: Zona IT" />
        </label>
      </header>
      <div class="main">
        <aside class="steps">
          <ol class="toc" id="toc" aria-label="Pași"></ol>
          <section class="step" id="step" aria-live="polite"></section>
          <div class="nav">
            <button type="button" class="btn-ghost" id="prev">← Înapoi</button>
            <button type="button" class="btn-primary" id="next">Mai departe →</button>
          </div>
        </aside>
        <main class="stage" id="stage">
          <div class="view" data-view="site" hidden>
            <div class="slot"><div class="fit"><div class="frame" data-w="1440" data-h="900" data-src={`${base}?demo=pitch&embed`} data-name="site"></div></div></div>
          </div>
          <div class="view" data-view="stream" hidden>
            <div class="slot"><p class="slot-label">Planul stream-ului · overlay-ul real rulează deasupra</p><div class="fit">
              <div class="frame" data-w="1920" data-h="1080" data-name="stream">
                <div class="scene" id="blueprint" data-focus="" style="width:1920px;height:1080px;background:#050A12"><StreamBlueprint /></div>
                <iframe data-overlay-src={`${base}overlay/?demo=pitch&promo=0&pos=tl`} title="Overlay" style="width:1920px;height:1080px"></iframe>
              </div>
            </div></div>
          </div>
          <div class="view" data-view="report" hidden><div class="final" id="report"></div></div>
          <div class="view" data-view="packages" hidden><div class="final" id="packages"></div></div>
        </main>
      </div>
    </div>
    <script>
      import '../scripts/sponsori';
    </script>
  </body>
</html>
