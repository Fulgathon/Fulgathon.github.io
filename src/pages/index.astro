---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource/barlow-condensed/900.css';
import '@fontsource/barlow-condensed/700-italic.css';
import '@fontsource/barlow-condensed/800-italic.css';
import '@fontsource/barlow-condensed/900-italic.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow/700.css';
import '../styles/global.css';

import { getImage } from 'astro:assets';
import emote from '../../assets/emote.png';
import logo from '../../assets/logo-mascot.webp';

import Top from '../components/Top.astro';
import Hero from '../components/Hero.astro';
import Live from '../components/Live.astro';
import Vote from '../components/Vote.astro';
import Wheel from '../components/Wheel.astro';
import Goals from '../components/Goals.astro';
import Rates from '../components/Rates.astro';
import BoardSchedule from '../components/BoardSchedule.astro';
import Play from '../components/Play.astro';
import Partners from '../components/Partners.astro';
import Footer from '../components/Footer.astro';
import DemoPanel from '../components/DemoPanel.astro';

const title = 'FULGATHON · Subathonul de Crăciun al lui Icemanlucky';
const description = 'FULGATHON: subathonul de Crăciun al lui Icemanlucky pe Twitch. Fiecare sub e un fulg. Facem viscol.';
const favicon = await getImage({ src: emote, format: 'png', width: 64 });
const ogImage = await getImage({ src: logo, format: 'jpg', width: 1200, quality: 82, background: '#050608' });
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const ogUrl = new URL(ogImage.src, Astro.site);
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050608" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div id="page" style="width: 100%; container-type: inline-size; container-name: page; position: relative; overflow: hidden; background: #050608; color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; font-size: 16px; line-height: 1.5">
      <a class="skip-link" href="#main">Sari la conținut</a>
      <Top />
      <main id="main" tabindex="-1">
        <Hero />
        <Live />
        <Vote />
        <Wheel />
        <Goals />
        <Rates />
        <BoardSchedule />
        <Play />
        <Partners />
      </main>
      <Footer />
      <DemoPanel />
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
