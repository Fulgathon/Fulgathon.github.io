---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/v2.css';

import { getImage } from 'astro:assets';
import emote from '../../assets/emote.png';
import logo from '../../assets/logo-mascot.webp';

import Top from '../components/Top.astro';
import Hero from '../components/Hero.astro';
import Live from '../components/Live.astro';
import Goals from '../components/Goals.astro';
import Play from '../components/Play.astro';
import Program from '../components/Program.astro';
import Partners from '../components/Partners.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import DemoPanel from '../components/DemoPanel.astro';

const title = 'ICEMARATON · Subathonul de Crăciun al lui Icemanlucky';
const description = 'ICEMARATON: subathonul de Crăciun al lui Icemanlucky pe Twitch. Fiecare sub e un fulg. Facem viscol.';
const favicon = await getImage({ src: emote, format: 'png', width: 64 });
const ogImage = await getImage({ src: logo, format: 'jpg', width: 1200, quality: 82, background: '#050608' });
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const ogUrl = new URL(ogImage.src, Astro.site);
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050608" />
    <meta name="color-scheme" content="dark" />
    <!-- The hero's fonts (timer digits, titles, body), so the first paint uses them. -->
    <link rel="preload" href="/fonts/barlow-condensed-900-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div id="page" style="width: 100%; container-type: inline-size; container-name: page; position: relative; overflow-x: clip; background: #050608; color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; font-size: 16px; line-height: 1.5">
      <a class="skip-link" href="#main">Sari la conținut</a>
      <Top />
      <main id="main" tabindex="-1">
        <Hero />
        <Partners />
        <Community />
        <Goals />
        <Play />
        <Live />
        <Program />
      </main>
      <Footer />
      <DemoPanel />
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
