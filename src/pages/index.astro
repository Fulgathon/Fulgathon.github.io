---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/v2.css';

import { getImage } from 'astro:assets';
import emote from '../../assets/emote.png';
import logo from '../../assets/logo-mascot.webp';

import Top from '../components/Top.astro';
import Hero from '../components/Hero.astro';
import Goals from '../components/Goals.astro';
import Play from '../components/Play.astro';
import Partners from '../components/Partners.astro';
import AddTime from '../components/AddTime.astro';
import Community from '../components/Community.astro';
import Footer from '../components/Footer.astro';
import DemoPanel from '../components/DemoPanel.astro';
import { site } from '../data/site';

const title = 'ICEMARATON · Subathonul de Crăciun al lui Icemanlucky';
const description = 'ICEMARATON: subathonul de Crăciun al lui Icemanlucky pe Twitch. Fiecare sub e un fulg. Facem viscol.';
const favicon = await getImage({ src: emote, format: 'png', width: 64 });
const ogImage = await getImage({ src: logo, format: 'jpg', width: 1200, quality: 82, background: '#050608' });
const pageUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const ogUrl = new URL(ogImage.src, Astro.site);
---
<!doctype html>
<html lang="ro" class="is-loading booting">
  <head>
    <meta charset="utf-8" />
    <!-- The loader never outstays 2.5 s: if the live data is slow the page shows anyway. -->
    <script is:inline>setTimeout(function () { document.documentElement.classList.remove('booting'); }, 2500);</script>
    <!-- The first public_state call starts here, in parallel with the page's JS, instead of after it
         (HTML → app → its modules → live.ts); live.ts picks up the answer (window.__ps). Not in ?demo. -->
    <script is:inline define:vars={{ psUrl: `${site.supabase.url}/rest/v1/rpc/public_state`, psKey: site.supabase.publishableKey }}>
      if (!/[?&]demo(=|&|$)/.test(location.search) && window.fetch) {
        var sent = Date.now();
        window.__ps = fetch(psUrl, { method: 'POST', headers: { apikey: psKey, 'Content-Type': 'application/json' }, body: '{"p_have":{}}' })
          .then(function (r) { var got = Date.now(); return r.ok ? r.text().then(function (text) { return { text: text, sent: sent, got: got }; }) : null; })
          .catch(function () { return null; });
      }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050608" />
    <meta name="color-scheme" content="dark" />
    <!-- The hero's fonts (timer digits, titles, body), so the first paint uses them. -->
    <link rel="preload" href="/fonts/barlow-condensed-900-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-condensed-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="boot" aria-hidden="true"><span class="boot-flake"></span></div>
    <div id="page" style="width: 100%; container-type: inline-size; container-name: page; position: relative; overflow-x: clip; background: #050608; color: #F2F5FA; font-family: Barlow, system-ui, sans-serif; font-size: 16px; line-height: 1.5">
      <a class="skip-link" href="#main">Sari la conținut</a>
      <Top />
      <main id="main" tabindex="-1">
        <Hero />
        <Partners />
        <AddTime />
        <Community />
        <Goals />
        <Play />
      </main>
      <Footer />
      <DemoPanel />
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
