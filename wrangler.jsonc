// Cloudflare Workers (static assets only): serves the built site from ./dist.
// Deploy with `npm run deploy` (builds with the right SITE_URL, then uploads).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icemaraton",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
